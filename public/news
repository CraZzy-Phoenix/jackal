<script>
(function(){
  const state={news:[],filter:'ALL',search:''};
  const $=s=>document.querySelector(s);
  const esc=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
  const date=v=>{if(!v)return '—';const raw=String(v).slice(0,10);const m=raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);return m?`${m[3]}.${m[2]}.${m[1]}`:String(v)};
  const cat=v=>{const x=String(v||'NEWS').toUpperCase();if(x.includes('ERGEB'))return 'ERGEBNISSE';if(x.includes('EVENT'))return 'EVENT';if(x.includes('UPDATE'))return 'UPDATE';if(x.includes('ALLG'))return 'ALLGEMEIN';return x||'NEWS'};
  const text=n=>n.text||n.content||'';
  const image=n=>n.image_url||n.image||'';
  const active=n=>{if(n.active!==undefined)return Number(n.active)===1||n.active===true||String(n.active).toLowerCase()==='true';if(n.status!==undefined){const s=String(n.status).toLowerCase();return ['active','aktiv','aktive','published','veröffentlicht','veroeffentlicht','1','true','ja'].includes(s)}return true};
  function filtered(){return state.news.filter(n=>{if(!active(n))return false;const c=cat(n.category);if(state.filter!=='ALL'&&c!==state.filter)return false;const q=state.search.trim().toLowerCase();if(q&&!`${n.title||''} ${text(n)} ${c}`.toLowerCase().includes(q))return false;return true}).sort((a,b)=>String(b.date||b.created_at||'').localeCompare(String(a.date||a.created_at||'')))}
  function imgHtml(url,title,cls){return url?`<img class="${cls||''}" src="${esc(url)}" alt="${esc(title)}" onerror="this.style.display='none'">`:`<div class="${cls||''}" style="height:100%;background:radial-gradient(circle at 50% 30%,#35145a,#080610 70%);display:grid;place-items:center;color:#b95cff;font-family:Permanent Marker;font-size:30px">JACKAL</div>`}
  function render(){const data=filtered();const featured=$('#featured'),list=$('#news-list');if(!data.length){featured.innerHTML='';list.innerHTML='<div class="empty">Aktuell sind keine News vorhanden.</div>';renderStats([]);return}
    const f=data[0], rest=data.slice(1);featured.innerHTML=`<article class="feature-grid"><div class="feature-card"><div class="feature-media">${imgHtml(image(f),f.title,'')}</div><div class="feature-copy"><span class="tag">${esc(cat(f.category))}</span><div class="feature-date">${esc(date(f.date||f.created_at))}</div><h2 class="feature-title">${esc(f.title||'JACKAL NEWS')}</h2><div class="feature-text">${esc(text(f))}</div><button class="read-btn" data-open="${esc(f.id)}">MEHR LESEN →</button><div class="feature-meta"><span>✦ JACKAL RACING LEAGUE</span><span>● ÖFFENTLICHE MELDUNG</span></div></div></div><aside class="side"><div class="side-title"><span>NEUIGKEITEN</span></div>${rest.slice(0,3).map(n=>`<article class="side-card"><div class="side-img">${imgHtml(image(n),n.title,'')}</div><div class="side-copy"><span class="tag">${esc(cat(n.category))}</span><div class="side-date">${esc(date(n.date||n.created_at))}</div><h3>${esc(n.title||'JACKAL NEWS')}</h3><p>${esc(text(n).slice(0,90))}</p></div><button class="side-arrow" data-open="${esc(n.id)}" aria-label="News öffnen">→</button></article>`).join('')}</aside></article>`;
    list.innerHTML=rest.slice(3).map(n=>`<article class="latest-card"><div class="latest-img">${imgHtml(image(n),n.title,'')}</div><div class="latest-body"><span class="tag">${esc(cat(n.category))}</span><div class="latest-date">${esc(date(n.date||n.created_at))}</div><h3>${esc(n.title||'JACKAL NEWS')}</h3><p>${esc(text(n).slice(0,170))}</p><div class="latest-bottom"><div class="stats"><span>● JACKAL</span></div><button class="small-read" data-open="${esc(n.id)}">MEHR LESEN →</button></div></div></article>`).join('');
    document.querySelectorAll('[data-open]').forEach(b=>b.addEventListener('click',()=>openNews(b.dataset.open)));renderStats(state.news.filter(active));
  }
  function renderStats(all){const cats={EVENT:0,ERGEBNISSE:0,UPDATE:0};all.forEach(n=>{const c=cat(n.category);if(cats[c]!==undefined)cats[c]++});$('#statsbar').innerHTML=`<div class="statbox"><svg viewBox="0 0 24 24"><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><div><strong>${all.length}</strong><small>NEWS INSGESAMT</small></div></div><div class="statbox"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2" fill="none"/><path d="M8 3v4M16 3v4M3 10h18"/></svg><div><strong>${cats.EVENT}</strong><small>EVENT BERICHTE</small></div></div><div class="statbox"><svg viewBox="0 0 24 24"><path d="M8 4h8v4h3v2c0 3-2 5-5 5h-1v3h4v2H7v-2h4v-3h-1c-3 0-5-2-5-5V8h3z" fill="none"/><path d="M5 8H3c0 4 2 6 5 6M19 8h2c0 4-2 6-5 6"/></svg><div><strong>${cats.ERGEBNISSE}</strong><small>ERGEBNISSE</small></div></div><div class="statbox"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="3" fill="none"/><path d="M19.4 15a7.9 7.9 0 0 0 0-6l2-1.5-2-3.4-2.4 1a8.4 8.4 0 0 0-5.2-3L11.5 0h-4l-.4 2.1a8.4 8.4 0 0 0-5.2 3l-2.4-1-2 3.4 2 1.5a7.9 7.9 0 0 0 0 6l-2 1.5 2 3.4 2.4-1a8.4 8.4 0 0 0 5.2 3l.4 2.1h4l.4-2.1a8.4 8.4 0 0 0 5.2-3l2.4 1 2-3.4z" transform="scale(.78) translate(3.4 3.4)"/></svg><div><strong>${cats.UPDATE}</strong><small>UPDATES</small></div></div>`}
  function openNews(id){const n=state.news.find(x=>String(x.id)===String(id));if(!n)return;$('#modalTitle').textContent=n.title||'JACKAL NEWS';$('#modalDate').textContent=date(n.date||n.created_at);$('#modalTag').innerHTML=`<span class="tag">${esc(cat(n.category))}</span>`;const im=image(n);const mi=$('#modalImage');if(im){mi.src=im;mi.style.display='block'}else{mi.removeAttribute('src');mi.style.display='none'}$('#modalContent').textContent=text(n)||'Keine weiteren Informationen vorhanden.';$('#newsModal').classList.add('open')}
  $('#modalClose').addEventListener('click',()=>$('#newsModal').classList.remove('open'));$('#newsModal').addEventListener('click',e=>{if(e.target===$('#newsModal'))$('#newsModal').classList.remove('open')});document.addEventListener('keydown',e=>{if(e.key==='Escape')$('#newsModal').classList.remove('open')});
  document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{state.filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('active',x===b));render()}));$('#search').addEventListener('input',e=>{state.search=e.target.value;render()});
  fetch('/api/public/data',{cache:'no-store'}).then(r=>r.json()).then(d=>{if(!d.ok)throw new Error(d.error||'API Fehler');state.news=Array.isArray(d.news)?d.news:[];render()}).catch(()=>{state.news=[];render()});
})();
</script>
