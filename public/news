              Noch keine News vorhanden.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- ================= RACE RESULTS ================= -->

    <section class="card laps">

      <div class="big-head">

        <svg
          class="big-icon"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2">

          <path d="M4 12h16"/>
          <path d="M12 4v16"/>

        </svg>

        <div>

          <h2 class="big-title">
            Ergebnisse
          </h2>

          <p class="big-sub">
            Letztes vergangenes Rennen
          </p>

        </div>

        <div class="select-wrap">

          <select id="lapFilter">

            <option value="">
              Alle Fahrzeuge
            </option>

          </select>

        </div>

      </div>

      <div class="table-wrap">

        <table class="tbl">

          <thead>

            <tr>
              <th>POS</th>
              <th>FAHRER</th>
              <th>FAHRZEUG</th>
              <th>BESTE RUNDE</th>
              <th>RENNEN</th>
              <th>PUNKTE</th>
            </tr>

          </thead>

          <tbody>

            <tr>
              <td>—</td>
              <td>Lade...</td>
              <td>—</td>
              <td>—</td>
              <td>—</td>
              <td>—</td>
            </tr>

          </tbody>

        </table>

