(function(){
  const state={news:[],filter:'ALL',search:''};
  const $=s=>document.querySelector(s);
  const esc=v=>String(v??'').replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;').replace(/'/g,'&#039;');
  const text=n=>String(n?.text||n?.content||'').trim();
  const image=n=>n?.image_url||n?.image||'';
  const date=v=>{const raw=String(v??'').slice(0,10),m=raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);return m?`${m[3]}.${m[2]}.${m[1]}`:(v||'—')};
  const cat=v=>{const x=String(v||'NEWS').trim().toUpperCase();if(x.includes('ERGEB'))return'ERGEBNISSE';if(x.includes('EVENT'))return'EVENT';if(x.includes('UPDATE'))return'UPDATE';if(x.includes('ALLG'))return'ALLGEMEIN';return'ALLGEMEIN'};
  const active=n=>{if(n?.active!==undefined)return Number(n.active)===1||n.active===true||['true','1','ja','aktiv','active'].includes(String(n.active).toLowerCase());if(n?.status!==undefined)return['active','aktiv','aktive','published','veröffentlicht','veroeffentlicht','1','true','ja'].includes(String(n.status).toLowerCase());return true};
  const sorted=a=>a.slice().sort((a,b)=>String(b?.date||b?.created_at||'').localeCompare(String(a?.date||a?.created_at||'')));
  const filtered=()=>sorted(state.news.filter(n=>{if(!active(n))return false;const c=cat(n.category);if(state.filter!=='ALL'&&c!==state.filter)return false;const q=state.search.trim().toLowerCase();return !q||`${n?.title||''} ${text(n)} ${c}`.toLowerCase().includes(q)}));
  function img(url,title){return url?`<img src="${esc(url)}" alt="${esc(title||'')}" onerror="this.style.display='none'">`:`<div style="height:100%;display:grid;place-items:center;background:radial-gradient(circle at 50% 30%,#40166a,#08070e 72%);color:#c35cff;font:800 22px var(--head);letter-spacing:2px">JACKAL</div>`}
  function tag(n){return `<span class="tag">${esc(cat(n.category))}</span>`}
  function openNews(id){const n=state.news.find(x=>String(x?.id)===String(id));if(!n)return;$('#modalTitle').textContent=n.title||'JACKAL NEWS';$('#modalDate').textContent=date(n.date||n.created_at);$('#modalTag').innerHTML=tag(n);const im=$('#modalImage'),u=image(n);if(u){im.src=u;im.style.display='block'}else{im.removeAttribute('src');im.style.display='none'}$('#modalContent').textContent=text(n)||'Keine weiteren Informationen vorhanden.';$('#newsModal').classList.add('open');$('#newsModal').setAttribute('aria-hidden','false')}
  function closeNews(){$('#newsModal').classList.remove('open');$('#newsModal').setAttribute('aria-hidden','true')}

  function render(){
    const all=filtered();
    const feature=all[0], side=all.slice(1,4), more=all.slice(4);
    $('#featured').innerHTML=feature?`<div class="feature"><div class="feature-image">${img(image(feature),feature.title)}</div><div class="feature-copy">${tag(feature)}<div class="date">${esc(date(feature.date||feature.created_at))}</div><h2>${esc(feature.title||'JACKAL NEWS')}</h2><p>${esc(text(feature).slice(0,420))}</p><button class="btn" data-open="${esc(feature.id)}">MEHR LESEN →</button><div class="feature-meta"><span>JACKAL RACING LEAGUE</span><span>● ÖFFENTLICHE NEWS</span></div></div></div>`:'<div class="empty">Aktuell sind keine News vorhanden.</div>';
    $('#side-list').innerHTML=side.length?side.map(n=>`<article class="side-item"><div class="side-image">${img(image(n),n.title)}</div><div class="side-copy">${tag(n)}<div class="date">${esc(date(n.date||n.created_at))}</div><h3>${esc(n.title||'JACKAL NEWS')}</h3><p>${esc(text(n).slice(0,85))}</p><button class="side-arrow" data-open="${esc(n.id)}">→</button></div></article>`).join(''):'<div class="empty" style="margin:0 9px 9px">Keine weiteren News.</div>';
    $('#changes-list').innerHTML=`<div class="change-box change-red"><div class="change-title"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9"/><path d="M8 8l8 8M16 8l-8 8"/></svg><h3>${side[0]?'TOP NEWS':'NEWS'}</h3><time>${side[0]?esc(date(side[0].date||side[0].created_at)):''}</time></div><ul><li>${side[0]?esc(side[0].title):'Keine weitere Meldung'}</li><li>${side[1]?esc(side[1].title):'Noch keine zweite Meldung'}</li></ul><span class="change-link">NEWS ÖFFNEN →</span></div><div class="change-box change-blue"><div class="change-title"><svg viewBox="0 0 24 24"><path d="M4 5h16v14H4z"/><path d="M8 9h8M8 13h5"/></svg><h3>KATEGORIEN</h3><time>LIVE</time></div><ul><li>Events · ${all.filter(n=>cat(n.category)==='EVENT').length}</li><li>Ergebnisse · ${all.filter(n=>cat(n.category)==='ERGEBNISSE').length}</li><li>Updates · ${all.filter(n=>cat(n.category)==='UPDATE').length}</li></ul><span class="change-link">FILTER VERWENDEN →</span></div>`;
    const cards=more.slice(0,4);
    $('#news-list').innerHTML=cards.length?cards.map(n=>`<article class="latest-item"><div class="latest-image">${img(image(n),n.title)}</div><div class="latest-copy">${tag(n)}<div class="date">${esc(date(n.date||n.created_at))}</div><h3>${esc(n.title||'JACKAL NEWS')}</h3><p>${esc(text(n).slice(0,120))}</p><div class="latest-row"><span class="stat">JACKAL NEWS</span><button class="read" data-open="${esc(n.id)}">MEHR LESEN →</button></div></div></article>`).join(''):'<div class="empty" style="grid-column:1/-1">Keine weiteren News vorhanden.</div>';
    const spotlight=all[1]||feature;
    $('#spotlight').innerHTML=spotlight?`<div class="spotlight-body"><div class="spot-image">${img(image(spotlight),spotlight.title)}</div><div class="spot-copy"><div class="page-kicker">HIGHLIGHT</div><h3>${esc(spotlight.title||'JACKAL NEWS')}</h3><div class="team">${esc(cat(spotlight.category))} · ${esc(date(spotlight.date||spotlight.created_at))}</div><p>${esc(text(spotlight).slice(0,210))}</p><button class="btn" data-open="${esc(spotlight.id)}">ZUM ARTIKEL →</button></div></div>`:'<div class="empty" style="margin:12px">Kein Highlight vorhanden.</div>';
    const archive=all.slice(4,8);
    $('#archive-list').innerHTML=archive.length?archive.map(n=>`<article class="latest-item"><div class="latest-image">${img(image(n),n.title)}</div><div class="latest-copy">${tag(n)}<div class="date">${esc(date(n.date||n.created_at))}</div><h3>${esc(n.title||'JACKAL NEWS')}</h3><p>${esc(text(n).slice(0,100))}</p><div class="latest-row"><span class="stat">ARCHIV</span><button class="read" data-open="${esc(n.id)}">ÖFFNEN →</button></div></div></article>`).join(''):'<div class="empty" style="grid-column:1/-1">Das Archiv füllt sich mit neuen Meldungen.</div>';
    document.querySelectorAll('[data-open]').forEach(b=>b.addEventListener('click',()=>openNews(b.dataset.open)));
    renderStats(state.news.filter(active));
  }
  function renderStats(all){const counts={EVENT:0,ERGEBNISSE:0,UPDATE:0};all.forEach(n=>{const c=cat(n.category);if(c in counts)counts[c]++});$('#statsbar').innerHTML=`<div class="statbox"><svg viewBox="0 0 24 24"><path d="M5 4h14v16H5z"/><path d="M8 8h8M8 12h8M8 16h5"/></svg><div><strong>${all.length}</strong><small>NEWS INSGESAMT</small></div></div><div class="statbox"><svg viewBox="0 0 24 24"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M8 3v4M16 3v4M3 10h18"/></svg><div><strong>${counts.EVENT}</strong><small>EVENT BERICHTE</small></div></div><div class="statbox"><svg viewBox="0 0 24 24"><path d="M8 4h8v4h3v2c0 3-2 5-5 5h-1v3h4v2H7v-2h4v-3h-1c-3 0-5-2-5-5V8h3z"/></svg><div><strong>${counts.ERGEBNISSE}</strong><small>ERGEBNISSE</small></div></div><div class="statbox"><svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="8"/><path d="M12 8v4l3 2"/></svg><div><strong>${counts.UPDATE}</strong><small>UPDATES</small></div></div>`}
  $('#search').addEventListener('input',e=>{state.search=e.target.value;render()});
  document.querySelectorAll('[data-filter]').forEach(b=>b.addEventListener('click',()=>{state.filter=b.dataset.filter;document.querySelectorAll('[data-filter]').forEach(x=>x.classList.toggle('active',x===b));render()}));
  $('#modalClose').addEventListener('click',closeNews);$('#newsModal').addEventListener('click',e=>{if(e.target===$('#newsModal'))closeNews()});document.addEventListener('keydown',e=>{if(e.key==='Escape')closeNews()});
  fetch('/api/public/data',{cache:'no-store'}).then(r=>r.json()).then(d=>{if(!d.ok)throw new Error('API');state.news=Array.isArray(d.news)?d.news:[];render()}).catch(()=>{state.news=[];render()});
})();
</script>
</body>
</html>
