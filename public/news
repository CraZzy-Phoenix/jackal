  <script>

    function esc(value) {

      return String(value ?? '')
        .replace(/[&<>'"]/g, function(c) {

          return ({
            '&':'&amp;',
            '<':'&lt;',
            '>':'&gt;',
            "'":'&#39;',
            '"':'&quot;'
          })[c];

        });

    }


    function mediaUrl(value) {

      if (!value) {
        return '';
      }

      const s = String(value);

      if (/^(https?:|data:|blob:)/i.test(s)) {
        return s;
      }

      if (s.startsWith('/media/')) {
        return s;
      }

      if (s.startsWith('media/')) {
        return '/' + s;
      }

      if (s.startsWith('/')) {
        return s;
      }

      return '/media/' +
        s
          .split('/')
          .map(encodeURIComponent)
          .join('/');

    }


    function formatDate(value) {

      if (!value) {
        return '—';
      }

      const date = new Date(value);

      if (isNaN(date.getTime())) {
        return String(value);
      }

      return new Intl.DateTimeFormat(
        'de-DE',
        {
          day:'2-digit',
          month:'2-digit',
          year:'numeric'
        }
      ).format(date);

    }


    function formatDateLong(value) {

      if (!value) {
        return '—';
      }

      const date = new Date(value);

      if (isNaN(date.getTime())) {
        return String(value);
      }

      return new Intl.DateTimeFormat(
        'de-DE',
        {
          day:'2-digit',
          month:'short',
          year:'numeric'
        }
      ).format(date);

    }


    function isPublicActive(value) {

      if (
        value === undefined ||
        value === null ||
        value === ''
      ) {
        return true;
      }

      const valueString =
        String(value)
          .toLowerCase()
          .trim();

      return ![
        '0',
        'false',
        'inactive',
        'inaktiv',
        'disabled',
        'draft',
        'deleted'
      ].includes(valueString);

    }


    function setImage(slot, source, alt) {

      if (!slot) {
        return;
      }

      slot.innerHTML = '';

      if (!source) {
        slot.classList.remove('loaded');
        slot.classList.add('missing');
        return;
      }

      const img =
        document.createElement('img');

      img.src = mediaUrl(source);
      img.alt = alt || '';

      img.addEventListener(
        'load',
        function() {

          slot.classList.add('loaded');
          slot.classList.remove('missing');

        }
      );

      img.addEventListener(
        'error',
        function() {

          slot.classList.add('missing');
          slot.classList.remove('loaded');

        }
      );

      slot.appendChild(img);

    }


    function setupMobileMenu() {

      const toggle =
        document.querySelector('.nav-toggle');

      const nav =
        document.querySelector('.nav');

      if (!toggle || !nav) {
        return;
      }

      toggle.addEventListener(
        'click',
        function() {

          nav.classList.toggle('open');

        }
      );

    }


    async function getWebsiteData() {

      const response =
        await fetch(
          '/api/public/data',
          {
            cache:'no-store'
          }
        );

      if (!response.ok) {
        throw new Error(
          'API ' + response.status
        );
      }

      const data =
        await response.json();

      if (!data.ok) {
        throw new Error(
          data.error || 'API Fehler'
        );
      }

      return data;

    }


    setupMobileMenu();


    (async function() {

      try {

        const data =
          await getWebsiteData();


        /*
         * NEWS
         */

        const news =
          (data.news || [])
            .filter(function(item) {

              return isPublicActive(
                item.active !== undefined
                  ? item.active
                  : item.status
              );

            })
            .sort(function(a,b) {

              return new Date(
                b.date || b.created_at || 0
              ) -
              new Date(
                a.date || a.created_at || 0
              );

            });


        /*
         * LATEST NEWS TABLE
         */

        const best =
          document.querySelector(
            '.bestlist'
          );

        if (best) {

          const meta =
            best.querySelector(
              '.head-meta'
            );

          if (meta) {

            meta.textContent =
              news.length
                ? formatDateLong(
                    news[0].date ||
                    news[0].created_at
                  )
                : 'Keine News';

          }


          const tbody =
            best.querySelector('tbody');

          if (tbody) {

            tbody.innerHTML =
              news
                .slice(0,8)
                .map(function(item) {

                  const text =
                    item.text ||
                    item.content ||
                    '';

                  return `
                    <tr>
                      <td>
                        ${esc(
                          formatDate(
                            item.date ||
                            item.created_at
                          )
                        )}
                      </td>

                      <td>
                        <strong>
                          ${esc(
                            item.title ||
                            'Ohne Titel'
                          )}
                        </strong>
                        <br>

                        <span style="opacity:.7">
                          ${esc(
                            text.slice(0,110)
                          )}
                        </span>
                      </td>

                      <td>
                        ${esc(
                          item.category ||
                          'News'
                        )}
                      </td>

                      <td>
                        ${esc(
                          item.status ||
                          'Aktiv'
                        )}
                      </td>
                    </tr>
                  `;

                })
                .join('');

          }

        }


        /*
         * NEXT RACE
         */

        const next =
          data.nextRace || null;

        const raceCard =
          document.querySelector(
            '.race-card'
          );

        if (raceCard) {

          const name =
            raceCard.querySelector(
              '.race-name'
            );

          const date =
            raceCard.querySelector(
              '.race-date'
            );

          const facts =
            raceCard.querySelector(
              '.race-facts'
            );

          if (name) {

            name.textContent =
              next
                ? (
                    next.name ||
                    next.title ||
                    'Next Race'
                  )
                : 'Kein nächstes Rennen';

          }

          if (date) {

            date.textContent =
              next
                ? (
                    formatDateLong(
                      next.date
                    ) +
                    (
                      next.time
                        ? ' · ' +
                          next.time +
                          ' Uhr'
                        : ''
                    )
                  )
                : '—';

          }

          if (facts) {

            facts.innerHTML =
              next
                ? `
                  <li>
                    ${esc(
                      next.location ||
                      next.city ||
                      '—'
                    )}
                  </li>

                  <li>
                    ${esc(
                      next.description ||
                      next.status ||
                      'Next Race'
                    )}
                  </li>
                `
                : `
                  <li>
                    Kein Next Race festgelegt
                  </li>
                `;

          }

          setImage(
            raceCard.querySelector(
              '.race-bg'
            ),
            next?.image_url ||
            next?.image ||
            '',
            next?.name ||
            'Next Race'
          );

        }


        /*
         * NEWS HIGHLIGHTS
         */

        const changes =
          document.querySelector(
            '.changes-list'
          );

        if (changes) {

          changes.innerHTML = '';

          news
            .slice(0,4)
            .forEach(function(item,index) {

              const article =
                document.createElement(
                  'article'
                );

              article.className =
                'change ' +
                (
                  index % 2
                    ? 'change-blue'
                    : 'change-red'
                );

              article.innerHTML = `
                <div class="change-head">

                  <h3>
                    ${esc(
                      item.category ||
                      'News'
                    )}
                  </h3>

                  <time>
                    ${esc(
                      formatDate(
                        item.date ||
                        item.created_at
                      )
                    )}
                  </time>

                </div>

                <ul>

                  <li>
                    <strong>
                      ${esc(
                        item.title ||
                        ''
                      )}
                    </strong>
                  </li>

                  <li>
                    ${esc(
                      (
                        item.text ||
                        item.content ||
                        ''
                      ).slice(0,180)
                    )}
                  </li>

                </ul>

                <a
                  class="change-link"
                  href="/news">

                  Mehr lesen

                </a>
              `;

              changes.appendChild(
                article
              );

            });

        }


        /*
         * NEWS-HIGHLIGHT
         */

        const hearts =
          document.querySelector(
            '.hearts'
          );

        if (hearts) {

          const first =
            news[0] || null;

          const winner =
            hearts.querySelector(
              '.winner'
            );

          if (winner) {

            winner.innerHTML =
              first
                ? `
                  <div
                    class="winner-info">

                    <strong>
                      ${esc(
                        first.title ||
                        'Latest News'
                      )}
                    </strong>

                    <p style="margin-top:10px">

                      ${esc(
                        first.text ||
                        first.content ||
                        ''
                      )}

                    </p>

                  </div>
                `
                : `
                  <div
                    class="winner-info">

                    Noch keine News vorhanden.

                  </div>
                `;

          }

        }


        /*
         * LETZTES VERGANGENES RENNEN
         */

        const laps =
          document.querySelector(
            '.laps'
          );

        const pastRaces =
          (data.races || [])
            .filter(function(race) {

              if (
                Number(
                  race.is_next
                ) === 1
              ) {
                return false;
              }

              const timestamp =
                new Date(
                  String(
                    race.date || ''
                  ) +
                  (
                    race.time
                      ? 'T' +
                        race.time
                      : 'T23:59:59'
                  )
                ).getTime();

              return (
                !isNaN(timestamp) &&
                timestamp < Date.now()
              );

            })
            .sort(function(a,b) {

              return new Date(
                b.date || 0
              ) -
              new Date(
                a.date || 0
              );

            });


        if (
          laps &&
          pastRaces.length
        ) {

          const race =
            pastRaces[0];

          const driverMap = {};

          (data.drivers || [])
            .forEach(function(driver) {

              driverMap[
                String(driver.id)
              ] = driver;

            });


          const results =
            (data.results || [])
              .filter(function(result) {

                return (
                  String(
                    result.race_id
                  ) ===
                  String(
                    race.id
                  )
                );

              })
              .sort(function(a,b) {

                return (
                  Number(
                    a.position
                  ) || 999
                ) -
                (
                  Number(
                    b.position
                  ) || 999
                );

              });


          const tbody =
            laps.querySelector(
              'tbody'
            );

          if (tbody) {

            tbody.innerHTML =
              results
                .slice(0,5)
                .map(function(result) {

                  const driver =
                    driverMap[
                      String(
                        result.driver_id
                      )
                    ] || {};

                  return `
                    <tr>

                      <td>
                        ${esc(
                          result.position ||
                          '—'
                        )}
                      </td>

                      <td>
                        ${esc(
                          driver.name ||
                          'Fahrer'
                        )}
                      </td>

                      <td>
                        ${esc(
                          result.vehicle ||
                          result.car ||
                          driver.car ||
                          '—'
                        )}
                      </td>

                      <td>
                        ${esc(
                          result.best_lap ||
                          result.bestlap ||
                          result.time ||
                          '—'
                        )}
                      </td>

                      <td>
                        ${esc(
                          result.time ||
                          '—'
                        )}
                      </td>

                      <td>
                        ${esc(
                          result.points ??
                          '—'
                        )}
                      </td>

                    </tr>
                  `;

                })
                .join('');

          }

          const subtitle =
            laps.querySelector(
              '.big-sub'
            );

          if (subtitle) {

            subtitle.textContent =
              race.name ||
              race.title ||
              'Letztes Rennen';

          }

        }

      }

      catch (error) {

        console.error(
          'JACKAL News:',
          error
        );

        const main =
          document.querySelector(
            '.grid-news'
          );

        if (main) {

          main.insertAdjacentHTML(
            'afterbegin',
            `
              <section class="card">
                <div
                  style="
                    padding:20px;
                    color:#ff8b8b;
                  ">
                  Die News konnten nicht
                  geladen werden.
                </div>
              </section>
            `
          );

        }

      }

    })();

  </script>

</body>
</html>
