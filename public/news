  ];
  const fallbackLaps=fallbackRanking.slice(0,5).map((r,i)=>({...r,diff:i?`+${['2,431','2,758','3,663','4,550'][i-1]}`:'–'}));
  const teamClass=t=>{const s=String(t||'').toLowerCase();if(s.includes('night'))return 'nightshift';if(s.includes('velocity'))return 'velocity';if(s.includes('phantom'))return 'phantom';return 'jackal'};
  const escape=s=>String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]));
  const formatDate=v=>{const s=String(v||'').slice(0,10),m=s.match(/^(\d{4})-(\d{2})-(\d{2})$/);return m?`${m[3]}. ${['JAN','FEB','MÄR','APR','MAI','JUN','JUL','AUG','SEP','OKT','NOV','DEZ'][Number(m[2])-1]} ${m[1]}`:s};
  function renderRanking(rows){
    const body=document.getElementById('rankingBody'); body.innerHTML=rows.slice(0,8).map((r,i)=>`<tr><td><span class="pos ${i<3?'pos-'+(i+1):''}">${i+1}</span></td><td><span class="driver-line"><span class="driver-dot">${escape(String(r.name||'?').slice(0,1))}</span><span class="driver">${escape(r.name||'–')}</span></span></td><td><span class="team ${teamClass(r.team)}">${escape(r.team||'–')}</span></td><td class="car">${escape(r.car||r.vehicle||'–')}</td><td class="time">${escape(r.time||r.best_lap||'–')}</td><td class="pts">${Number(r.points)||0}</td></tr>`).join('');
  }
  function renderLaps(rows){
    const body=document.getElementById('lapsBody'); body.innerHTML=rows.slice(0,5).map((r,i)=>`<tr><td><span class="pos ${i<3?'pos-'+(i+1):''}">${i+1}</span></td><td class="lap-driver">${escape(r.name||'–')}</td><td>${escape(r.car||r.vehicle||'–')}</td><td class="lap-time">${escape(r.best_lap||r.bestlap||r.time||'–')}</td><td class="lap-time">${escape(r.time||'–')}</td><td class="diff pos">${escape(r.diff|| (i?`+${['2,431','2,758','3,663','4,550'][i-1]}`:'–'))}</td></tr>`).join('');
  }
  renderRanking(fallbackRanking); renderLaps(fallbackLaps);
  fetch('/api/public/data',{cache:'no-store'}).then(r=>r.json()).then(data=>{
    const ranking=Array.isArray(data.ranking)?data.ranking:[]; if(ranking.length){renderRanking(ranking);renderLaps(ranking.slice(0,5)); const champ=ranking[0]; if(champ){document.getElementById('heartWinner').textContent=champ.name||'Apex';document.getElementById('heartTeam').textContent=champ.team||'TEAM JACKAL'}}
    const n=data.nextRace; if(n){document.getElementById('nextName').textContent=n.name||n.title||document.getElementById('nextName').textContent;document.getElementById('nextLoc').innerHTML=escape(n.location||'LOS SANTOS')+'<br>SANDY SHORES AIRFIELD';document.getElementById('nextDate').textContent=formatDate(n.date);document.getElementById('nextDay').textContent=(n.time||'20:00')+' UHR (MEZ)';if(n.image_url)document.getElementById('nextBg').style.backgroundImage=`url('${String(n.image_url).replace(/'/g,"%27")}')`;}
    const first=(data.races||[]).find(r=>Number(r.is_next)===1); if(!n&&first){if(first.image_url)document.getElementById('nextBg').style.backgroundImage=`url('${String(first.image_url).replace(/'/g,"%27")}')`;}
  }).catch(()=>{});
})();
