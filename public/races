<script>
(function(){

function escapeHtml(value){
  return String(value ?? '')
    .replace(/&/g,'&amp;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;')
    .replace(/'/g,'&#039;');
}

function imageSlot(url, label, alt='', cls=''){
  if(url){
    return `<div class="img-slot ${cls}" data-label="${escapeHtml(label)}"><img src="${escapeHtml(url)}" alt="${escapeHtml(alt)}"></div>`;
  }
  return `<div class="img-slot ${cls}" data-label="${escapeHtml(label)}"></div>`;
}

function wireImageSlots(root=document){
  root.querySelectorAll('.img-slot img').forEach(function(img){
    var slot = img.closest('.img-slot');
    function ok(){ if(slot){ slot.classList.add('loaded'); slot.classList.remove('missing'); } }
    function fail(){ if(slot){ slot.classList.add('missing'); slot.classList.remove('loaded'); } }
    if(img.complete) img.naturalWidth > 0 ? ok() : fail();
    img.addEventListener('load', ok);
    img.addEventListener('error', fail);
  });
}

async function loadJackalData(){
  if(window.__JACKAL_DATA_PROMISE) return window.__JACKAL_DATA_PROMISE;
  window.__JACKAL_DATA_PROMISE = fetch('/api/public/data', {cache:'no-store'})
    .then(function(r){ if(!r.ok) throw new Error('Website-Daten konnten nicht geladen werden.'); return r.json(); })
    .then(function(d){ if(!d.ok) throw new Error(d.error || 'Website-Daten konnten nicht geladen werden.'); window.__JACKAL_DATA=d; return d; });
  return window.__JACKAL_DATA_PROMISE;
}

function raceDateTime(race){
  if(!race || !race.date) return null;
  var time = race.time || '00:00';
  var d = new Date(String(race.date).slice(0,10) + 'T' + String(time).slice(0,5) + ':00');
  return isNaN(d.getTime()) ? null : d;
}

function formatDateDe(value){
  if(!value) return '—';
  var raw=String(value).slice(0,10);
  var m=raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if(!m) return String(value);
  return `${m[3]}.${m[2]}.${m[1]}`;
}

function formatDateShort(value){
  if(!value) return '—';
  var raw=String(value).slice(0,10);
  var m=raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if(!m) return String(value);
  var months=['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
  return `${m[3]}. ${months[Number(m[2])-1] || m[2]} ${m[1]}`;
}

function isPastRace(race){
  var d=raceDateTime(race);
  return d ? d.getTime() < Date.now() : !Number(race && race.is_next);
}

function driverMap(data){
  var map=new Map();
  (data.drivers || []).forEach(function(d){ map.set(String(d.id),d); });
  return map;
}

  function resultDriver(r,map){return map.get(String(r.driver_id)) || null;}
  function render(data){
    var grid=document.querySelector('.races-grid'); if(!grid)return;
    var raceRows=(data.races||[]).filter(isPastRace).sort(function(a,b){return (raceDateTime(b)?.getTime()||0)-(raceDateTime(a)?.getTime()||0);});
    var results=data.results||[]; var dmap=driverMap(data);
    var locSelect=document.querySelector('select[data-key="loc"]'), typeSelect=document.querySelector('select[data-key="type"]'), seasonSelect=document.querySelector('select[data-key="season"]');
    if(locSelect){locSelect.innerHTML='<option value="">Alle Strecken</option>';[...new Set(raceRows.map(function(r){return r.location||'';}).filter(Boolean))].sort().forEach(function(v){locSelect.add(new Option(v,v));});}
    if(typeSelect){typeSelect.innerHTML='<option value="">Alle Rennarten</option>';typeSelect.disabled=true;}
    if(seasonSelect){seasonSelect.innerHTML='<option value="">Alle Saisons</option>';[...new Set(raceRows.map(function(r){return String(r.date||'').slice(0,4);}).filter(Boolean))].sort().reverse().forEach(function(v){seasonSelect.add(new Option('Saison '+v,v));});}
    grid.innerHTML=raceRows.length?raceRows.map(function(r){var rs=results.filter(function(x){return String(x.race_id)===String(r.id);}).sort(function(a,b){return (Number(a.position)||999)-(Number(b.position)||999);}).slice(0,3);var date=String(r.date||'').slice(0,10);var day=date.slice(8,10)||'--';var mon=['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'][Number(date.slice(5,7))-1]||'';var year=date.slice(0,4)||'';return `<article class="card race-tile" data-item data-loc="${escapeHtml(r.location||'')}" data-season="${escapeHtml(year)}" data-type="" data-search="${escapeHtml((r.name||'')+' '+(r.location||'')+' '+String(r.description||''))}"><div class="rt-top">${imageSlot(r.image_url,'race-'+r.id+'.jpg',r.name||'','rt-img')}<div class="rt-date"><b>${escapeHtml(day)}</b><span>${escapeHtml(mon)}</span><span>${escapeHtml(year)}</span></div></div><div class="rt-body"><h2 class="rt-title">${escapeHtml(r.name||'Rennen')}</h2><p class="rt-loc"><svg viewBox="0 0 24 24"><path d="M12 2a7 7 0 0 0-7 7c0 5.3 7 13 7 13s7-7.7 7-13a7 7 0 0 0-7-7Zm0 9.5A2.5 2.5 0 1 1 12 6.5a2.5 2.5 0 0 1 0 5Z"/></svg>${escapeHtml(r.location||'—')}</p><div class="rt-meta"><span class="chip chip-type">Vergangen</span><span class="chip">${rs.length ? rs.length+' Ergebnisse' : 'Keine Ergebnisse'}</span></div></div><div class="rt-results"><table class="tbl"><thead><tr><th colspan="3">Ergebnisse</th><th class="r">Zeit</th></tr></thead><tbody>${rs.length?rs.map(function(x,i){var d=resultDriver(x,dmap);return `<tr><td><span class="pos ${i<3?'pos-'+(i+1):''}">${escapeHtml(String(x.position ?? i+1))}</span></td><td class="driver">${escapeHtml(d?.nickname||'Unbekannter Fahrer')}</td><td>${escapeHtml(x.vehicle||x.car||d?.car||'—')}</td><td class="time r">${escapeHtml(x.time||x.best_lap||x.bestlap||'—')}</td></tr>`;}).join(''):'<tr><td colspan="4">Keine Rennergebnisse eingetragen.</td></tr>'}</tbody></table></div></article>`;}).join(''):'<p class="filter-empty" style="display:block">Noch keine vergangenen Rennen vorhanden.</p>';
    var search=document.querySelector('[data-filter-search]');function apply(){var q=(search?.value||'').trim().toLowerCase();var shown=0;grid.querySelectorAll('[data-item]').forEach(function(el){var ok=!q||el.dataset.search.includes(q);if(locSelect?.value)ok=ok&&el.dataset.loc===locSelect.value;if(seasonSelect?.value)ok=ok&&el.dataset.season===seasonSelect.value;if(typeSelect?.value)ok=false;el.style.display=ok?'':'none';if(ok)shown++;});var empty=grid.querySelector('.filter-empty');if(empty)empty.style.display=shown?'none':'block';} [search,locSelect,typeSelect,seasonSelect].filter(Boolean).forEach(function(el){el.oninput=apply;el.onchange=apply;});apply();wireImageSlots(grid);
  }
  function init(){loadJackalData().then(render).catch(console.error);wireImageSlots();}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>

