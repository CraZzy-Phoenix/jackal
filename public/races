}
.rt-date b { display: block; font-size: 30px; font-weight: 700; }
.rt-date span { display: block; font-size: 17px; text-transform: uppercase; color: #d4cde8; }
.rt-body { position: relative; z-index: 3; margin-top: -34px; padding: 0 16px 10px; }
.rt-title { font-family: var(--f-head); font-style: italic; font-weight: 800; font-size: 22px; line-height: 1.1; text-transform: uppercase; }
.rt-loc { display: flex; align-items: center; gap: 8px; margin: 4px 0 10px; font-size: 15px; font-weight: 500; color: #e6e1f5; }
