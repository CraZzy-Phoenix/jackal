  grid-template-columns: 68px 1fr auto 34px;
  align-items: stretch;
  min-height: 110px;
  background: linear-gradient(90deg, #15112a, #100d1f 60%, #15102a);
  border: 1px solid #3a2a66;
  border-radius: 5px;
  overflow: hidden;
  transition: border-color .2s, box-shadow .2s, transform .2s;
}
.driver-card:hover { border-color: #b266ff; box-shadow: 0 0 18px rgba(168, 85, 255, .55); transform: translateY(-2px); }
.dc-badge {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: linear-gradient(180deg, rgba(168, 85, 255, .25), rgba(168, 85, 255, .05));
  border-right: 1px solid #2a2342;
}
.dc-num {
  width: 100%;
  padding: 6px 0 4px;
  text-align: center;
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 26px;
  line-height: 1;
  color: #fff;
  background: #2a1d55;
}
.rank-1 .dc-num { background: linear-gradient(180deg, #a0661a, #6b3d0a); }
.rank-2 .dc-num { background: linear-gradient(180deg, #3b3f9e, #262966); }
.rank-3 .dc-num { background: linear-gradient(180deg, #a0461a, #66280a); }
.dc-logo {
  width: 40px; height: 40px;
  margin: auto 0;
  border-radius: 50%;
  background: rgba(255, 255, 255, .04);
}
.dc-logo::after { border: 1.5px solid currentColor; border-radius: 50%; font: 700 16px/1 var(--f-head); letter-spacing: 0; color: inherit; padding: 0; }
.dc-logo img { object-fit: contain; }

.dc-main { padding: 14px 10px 12px 18px; display: flex; flex-direction: column; justify-content: center; gap: 6px; min-width: 0; }
.dc-name {
  font-family: var(--f-head);
  font-style: italic;
  font-weight: 800;
  font-size: 24px;
  line-height: 1;
  text-transform: uppercase;
  margin-bottom: 4px;
}
.dc-row { display: flex; align-items: center; gap: 12px; font-size: 14px; font-weight: 600; text-transform: uppercase; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.dc-row .team-ico { width: 20px; height: 20px; }
.dc-row svg { width: 20px; height: 20px; flex-shrink: 0; color: #e6e1f5; }

.dc-stats { display: grid; align-content: center; gap: 4px; padding: 10px 8px; }
.dc-stat { display: grid; grid-template-columns: 22px auto; align-items: center; gap: 8px; }
.dc-stat svg { width: 18px; height: 18px; color: #e6e1f5; }
.dc-stat .trophy { color: var(--purple-2); }
.dc-stat b { display: block; font-family: var(--f-head); font-weight: 600; font-size: 18px; line-height: 1; }
.dc-stat small { display: block; font-size: 9px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: #a49cbc; line-height: 1.1; }

.dc-go { display: grid; place-items: center; color: var(--purple-2); }
.dc-go svg { width: 26px; height: 26px; transition: transform .2s; }
.driver-card:hover .dc-go svg { transform: translateX(3px); }

.no-result { grid-column: 1 / -1; padding: 30px; text-align: center; color: #a49cbc; font-weight: 600; text-transform: uppercase; display: none; }

/* Statistikleiste */
.stats-bar {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  padding: 14px 0;
}
.stats-bar .img-slot.stats-bg { position: absolute; inset: 0; }
.stats-bar .stats-bg::after { border: 0; place-items: center end; padding-right: 16px; opacity: .6; }
.stats-bar::before {
  content: ""; position: absolute; inset: 0; z-index: 2; pointer-events: none;
  background: linear-gradient(90deg, rgba(14, 11, 26, .85), rgba(14, 11, 26, .6), rgba(14, 11, 26, .85));
}
.stat {
  position: relative;
  z-index: 3;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 22px;
  padding: 6px 12px;
}
.stat + .stat { border-left: 1px solid var(--line); }
.stat svg { width: 46px; height: 46px; flex-shrink: 0; color: var(--purple-2); fill: var(--purple-2); filter: drop-shadow(0 0 8px rgba(168, 85, 255, .9)); }
.stat b { display: block; font-family: var(--f-head); font-weight: 700; font-size: 34px; line-height: 1; }
.stat span { display: block; margin-top: 4px; font-size: 15px; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; color: #d4cde8; }

/* Responsive Drivers */
@media (max-width: 1280px) {
  .drivers-grid { grid-template-columns: repeat(2, 1fr); }
  .tools { margin-left: 0; width: 100%; }
}
@media (max-width: 860px) {
  .drivers-grid { grid-template-columns: 1fr; padding: 6px 14px 16px; }
  .drivers-head { padding: 14px; }
  .stats-bar { grid-template-columns: 1fr 1fr; row-gap: 14px; }
  .stat:nth-child(odd) { border-left: 0; }
  .search { width: 100%; }
  .filters { width: 100%; }
  .filters .select-wrap { flex: 1; min-width: 0; }
  .filters select { width: 100%; padding-right: 30px; font-size: 12px; padding-left: 10px; }
}
@media (max-width: 640px) {
  .hero-page { height: 190px; }
  .wrap-page { padding: 0 16px 20px; }
  .driver-card { grid-template-columns: 60px 1fr auto 26px; }
  .dc-main { padding-left: 12px; }
  .dc-name { font-size: 21px; }
  .dc-row { font-size: 12px; gap: 8px; }
  .stat { flex-direction: column; gap: 8px; text-align: center; }
  .stat svg { width: 36px; height: 36px; }
  .stat b { font-size: 28px; }
  .stat span { font-size: 12px; }
}
/* Tabellen */
.table-wrap { padding: 0 10px; overflow-x: auto; }
.tbl { width: 100%; border-collapse: separate; border-spacing: 0 2px; font-size: 15px; }
.tbl th {
  padding: 6px 8px;
  font-size: 12px;
  font-weight: 600;
  text-align: left;
  text-transform: uppercase;
  color: #d4cde8;
  white-space: nowrap;
}
.tbl td {
  padding: 5px 8px;
