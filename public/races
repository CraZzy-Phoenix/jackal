<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Races – Jackal Racing League</title>
<link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Saira+Condensed:wght@600;700;800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#07060d;--card:#110e1f;--card2:#171329;--line:#2a2342;--purple:#4e18ae;--accent:#b266ff;--neon:#a855ff;--text:#f2eefc;--muted:#a49cbc;--head:'Saira Condensed',sans-serif;--body:'Rajdhani',sans-serif;--brush:'Permanent Marker',cursive}
*{box-sizing:border-box;margin:0;padding:0}body{background:radial-gradient(1200px 500px at 50% 0,rgba(168,85,255,.12),transparent 60%),var(--bg);color:var(--text);font-family:var(--body);min-height:100vh}a{color:inherit;text-decoration:none}
.topbar{height:58px;position:sticky;top:0;z-index:50;display:flex;align-items:center;padding:0 36px;background:rgba(8,7,14,.94);border-bottom:1px solid var(--line)}.brand{font:30px var(--brush);text-transform:uppercase;text-shadow:0 0 12px rgba(178,102,255,.8),2px 2px 0 var(--purple)}.nav{position:absolute;left:50%;transform:translateX(-50%);display:flex}.nav a{padding:20px 15px;font-size:13px;font-weight:700;text-transform:uppercase;position:relative;color:#d9d3ec}.nav a:hover,.nav a.active{color:#fff}.nav a.active:after{content:"";position:absolute;left:10px;right:10px;bottom:5px;height:2px;background:var(--accent);box-shadow:0 0 10px var(--neon)}.nav-toggle{display:none;margin-left:auto;background:none;border:0}.nav-toggle span{display:block;width:24px;height:2px;background:#fff;margin:5px}
.hero{height:230px;position:relative;overflow:hidden;border-bottom:1px solid var(--line)}.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(to bottom,rgba(7,6,13,.15),rgba(7,6,13,.75),var(--bg))}.hero-content{position:relative;z-index:2;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center}.hero-title{font:88px var(--brush);background:linear-gradient(#f1e8ff,#b98cff,#7a3fe0);background-clip:text;-webkit-background-clip:text;color:transparent;transform:skew(-10deg)}.hero-sub{margin-top:8px;font-weight:700;text-transform:uppercase;letter-spacing:.4em}.hero-claim{color:var(--accent);font-style:italic;font-weight:700}
.page{max-width:1500px;margin:18px auto;padding:0 18px 35px}.toolbar{display:flex;gap:12px;padding:16px;background:linear-gradient(100deg,rgba(168,85,255,.13),transparent 55%);border:1px solid var(--line);border-radius:10px;margin-bottom:16px;flex-wrap:wrap}.search,.select{height:40px;background:#0e0c1a;border:1px solid var(--line);color:#fff;border-radius:5px;padding:0 12px;font:600 14px var(--body)}.search{flex:1;min-width:220px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.race{background:linear-gradient(180deg,var(--card2),var(--card));border:1px solid var(--line);border-radius:10px;overflow:hidden}.race-img{height:180px;background:#0e0c1a}.race-img img{width:100%;height:100%;object-fit:cover}.race-body{padding:15px}.race-title{font:700 28px var(--head);text-transform:uppercase}.date{margin-top:2px;color:var(--accent);font-weight:700}.loc{margin-top:8px;color:#d4cde8;font-weight:600;text-transform:uppercase}.desc{margin-top:10px;color:var(--muted);font-size:14px}.results{margin-top:14px;border-top:1px solid var(--line);padding-top:10px}.results-row{display:grid;grid-template-columns:38px 1fr 1fr;gap:8px;padding:5px 0;font-size:13px}.results-row b{color:var(--accent)}.empty{padding:30px;text-align:center;color:var(--muted);font-weight:700;grid-column:1/-1}
.footer{display:grid;grid-template-columns:1fr auto 1fr;gap:15px;padding:16px 40px;border-top:1px solid var(--line);font-weight:700;text-transform:uppercase;letter-spacing:.08em}.footer-center{font-family:var(--brush);color:var(--accent);text-align:center}.footer-right{text-align:right}
@media(min-width:1550px){.page{max-width:1550px}}@media(max-width:1050px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:960px){.nav-toggle{display:block}.nav{display:none;left:0;right:0;top:58px;transform:none;flex-direction:column;background:rgba(8,7,14,.98)}.nav.open{display:flex}.nav a{padding:14px 24px}.grid{grid-template-columns:1fr}}@media(max-width:600px){.topbar{padding:0 16px}.hero-title{font-size:68px}.footer{grid-template-columns:1fr;text-align:center}.footer-right{text-align:center}}

/* PUBLIC LOGIN BUTTON */
.login-link{margin-left:auto;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-width:96px;height:36px;padding:0 14px;border:1px solid var(--accent);border-radius:3px;color:#fff;background:linear-gradient(180deg,#5c22c4 0%,var(--purple) 55%,#43149a 100%);box-shadow:0 0 12px rgba(168,85,255,.35),inset 0 1px 0 rgba(255,255,255,.1);font-family:var(--head);font-size:15px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;transition:filter .2s,box-shadow .2s}.login-link:hover{filter:brightness(1.12);box-shadow:0 0 18px rgba(178,102,255,.55),0 0 30px rgba(168,85,255,.22),inset 0 1px 0 rgba(255,255,255,.16)}.login-link svg{width:16px;height:16px;flex-shrink:0}
@media(max-width:960px){.login-link{min-width:82px;height:34px;padding:0 11px;font-size:13px;margin-left:10px}}

</style>

<style id="jackalPublicLoginStyle">
.jackal-login-overlay{position:fixed;inset:0;z-index:5000;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(4,3,10,.64);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px)}
.jackal-login-overlay.open{display:flex}
.jackal-login-modal{width:min(390px,calc(100vw - 32px));padding:26px;border:1px solid #2a2342;border-radius:10px;background:linear-gradient(180deg,#171329,#110e1f);box-shadow:0 24px 90px rgba(0,0,0,.65),0 0 28px rgba(168,85,255,.18);position:relative}
.jackal-login-close{position:absolute;top:12px;right:12px;width:32px;height:32px;border:1px solid #2a2342;border-radius:4px;background:#0f0c18;color:#cfc7dd;font:700 18px 'Rajdhani',sans-serif;line-height:1;cursor:pointer}.jackal-login-close:hover{color:#fff;border-color:#b266ff;box-shadow:0 0 12px rgba(168,85,255,.2)}
.jackal-login-kicker{font:700 12px 'Rajdhani',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#b266ff}.jackal-login-title{margin-top:4px;font:800 34px 'Saira Condensed',sans-serif;font-style:italic;text-transform:uppercase;color:#fff}.jackal-login-sub{margin-top:4px;color:#a49cbc;font:600 13px 'Rajdhani',sans-serif}
.jackal-login-form{margin-top:20px}.jackal-login-field{margin-bottom:12px}.jackal-login-field label{display:block;margin-bottom:6px;color:#b9b0ca;font:700 11px 'Rajdhani',sans-serif;letter-spacing:.1em;text-transform:uppercase}.jackal-login-field input{width:100%;height:42px;padding:0 12px;border:1px solid #2a2342;border-radius:5px;background:#0e0c1a;color:#fff;outline:none;font:600 14px 'Rajdhani',sans-serif}.jackal-login-field input:focus{border-color:#b266ff;box-shadow:0 0 0 2px rgba(168,85,255,.08)}
.jackal-login-submit{width:100%;height:42px;margin-top:4px;border:1px solid #b266ff;border-radius:4px;color:#fff;background:linear-gradient(180deg,#5c22c4 0%,#4e18ae 55%,#43149a 100%);box-shadow:0 0 16px rgba(168,85,255,.3),inset 0 1px 0 rgba(255,255,255,.08);font:800 16px 'Saira Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;cursor:pointer}.jackal-login-submit:hover{filter:brightness(1.1);box-shadow:0 0 22px rgba(178,102,255,.48)}
.jackal-login-message{min-height:18px;margin-top:10px;color:#ff6f8d;font:600 12px 'Rajdhani',sans-serif;text-align:center}.jackal-login-note{margin-top:12px;color:#716981;font:500 11px 'Rajdhani',sans-serif;text-align:center}
.login-link.is-authenticated{border-color:#6f3ad7}
@media(max-width:960px){.jackal-login-modal{padding:22px}.jackal-login-title{font-size:30px}}
</style>

</head>
<body>
<header class="topbar"><a href="/" class="brand">Jackal</a><button class="nav-toggle"><span></span><span></span><span></span></button><nav class="nav"><a href="/">Home</a><a href="/news">News</a><a href="/drivers">Drivers</a><a href="/rangliste">Rangliste</a><a href="/races" class="active">Races</a><a href="/blacklist">Blacklist</a><a href="/gallery">Gallery</a></nav><a class="login-link" href="/admin" aria-label="Zum Admin-Login"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V8a5 5 0 0 1 10 0v3"></path></svg><span>Login</span></a></header>

<section class="hero"><img src="jackal-banner.png" alt=""><div class="hero-content"><h1 class="hero-title">Races</h1><p class="hero-sub">Vergangene Rennen</p><p class="hero-claim">We are Jackal. We are racing.</p></div></section>

<main class="page">
<div class="toolbar"><input id="search" class="search" placeholder="Rennen durchsuchen..."><select id="location" class="select"><option value="">Alle Strecken</option></select></div>
<section id="grid" class="grid"></section>
</main>

<footer class="footer"><span>Jackal Racing League</span><span class="footer-center">We are Jackal. We are racing.</span><span class="footer-right">Los Santos · Est. 2026</span></footer>

<style>.race.is-selected{border-color:#b266ff!important;box-shadow:0 0 28px rgba(168,85,255,.34)}.results-row small{display:block;grid-column:2/-1;font-size:11px;color:#b9a9d4;margin-top:2px}</style>
<script>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const media=v=>{if(!v)return'';v=String(v);if(v.startsWith('/media/'))return v;if(v.startsWith('media/'))return'/'+v;if(/^https?:/i.test(v))return v;return'/media/'+v.split('/').map(encodeURIComponent).join('/')};
const date=v=>{if(!v)return'—';let d=new Date(v);return isNaN(d)?String(v):new Intl.DateTimeFormat('de-DE',{day:'2-digit',month:'short',year:'numeric'}).format(d)};
const gridEl=document.getElementById('grid'),searchEl=document.getElementById('search'),locationEl=document.getElementById('location');
(async()=>{
try{
 const r=await fetch('/api/public/data',{cache:'no-store'}),d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||'Website-Daten konnten nicht geladen werden.');
 const now=Date.now(),drivers=d.drivers||[],results=d.results||[];
 const selectedRaceParam=new URLSearchParams(location.search).get('race');
 const races=(d.races||[]).filter(x=>{const keepSelected=selectedRaceParam&&String(x.id)===String(selectedRaceParam);if(Number(x.is_next)===1&&!keepSelected)return false;const raw=String(x.date||'');const ts=new Date(raw+(x.time?'T'+String(x.time).slice(0,5):'T23:59:59')).getTime();const st=String(x.status||'').toLowerCase();return keepSelected||['completed','finished','past','abgeschlossen','beendet'].includes(st)||(!Number.isNaN(ts)&&ts<now)}).sort((a,b)=>new Date(String(b.date||'1970-01-01'))-new Date(String(a.date||'1970-01-01')));
 const locs=[...new Set(races.map(x=>x.location).filter(Boolean))].sort((a,b)=>String(a).localeCompare(String(b),'de-DE'));locs.forEach(x=>locationEl.add(new Option(x,x)));
 const map={};drivers.forEach(x=>map[String(x.id)]=x);
 function render(){
   const q=searchEl.value.toLowerCase().trim(),l=locationEl.value;
   const selectedRace=selectedRaceParam;
   const list=races.filter(x=>(!q||[x.name,x.location,x.description].join(' ').toLowerCase().includes(q))&&(!l||x.location===l));
   gridEl.innerHTML=list.length?list.map(x=>{
      const rr=results.filter(y=>String(y.race_id)===String(x.id)).sort((a,b)=>(Number(a.position)||999)-(Number(b.position)||999));
      const shownResults=selectedRace&&String(selectedRace)===String(x.id)?rr:rr.slice(0,5);
      return `<article class="race" data-race-id="${esc(String(x.id||''))}" id="race-${esc(String(x.id||''))}"><div class="race-img">${x.image_url?`<img src="${esc(media(x.image_url))}" alt="">`:''}</div><div class="race-body"><h2 class="race-title">${esc(x.name||'Rennen')}</h2><div class="date">${esc(date(x.date))}${x.time?' · '+esc(x.time)+' Uhr':''}</div><div class="loc">${esc(x.location||'—')}</div>${x.description?`<p class="desc">${esc(x.description)}</p>`:''}<div class="results">${shownResults.length?shownResults.map((y,i)=>{const drv=map[String(y.driver_id)]||{};return `<div class="results-row"><b>${Number(y.position)||i+1}</b><span>${esc(drv.nickname||'Fahrer')}</span><span>${esc(y.vehicle||y.car||drv.car||'—')}</span>${selectedRace&&String(selectedRace)===String(x.id)?`<small>${esc(y.best_lap||y.bestlap||'—')} · ${esc(y.time||'—')}</small>`:''}</div>`}).join(''):'<div class="empty">Keine Rennergebnisse vorhanden.</div>'}</div></div></article>`;
   }).join(''):'<div class="empty">Keine vergangenen Rennen gefunden.</div>';
 }
 render();searchEl.oninput=render;locationEl.onchange=render;
 const raceParam=new URLSearchParams(location.search).get('race');
 if(raceParam){const safeId=String(raceParam).replace(/[^a-zA-Z0-9_-]/g,'');const target=document.querySelector(`[data-race-id="${safeId}"]`);if(target){target.classList.add('is-selected');requestAnimationFrame(()=>target.scrollIntoView({behavior:'smooth',block:'center'}));}}
 const viewParam=new URLSearchParams(location.search).get('view');
 if(raceParam&&viewParam==='laps'){const safeId=String(raceParam).replace(/[^a-zA-Z0-9_-]/g,'');const target=document.querySelector(`[data-race-id="${safeId}"]`);if(target){const title=target.querySelector('.race-title');if(title)title.textContent+=' · RUNDENZEITEN';}}
}catch(e){console.error(e);gridEl.innerHTML='<div class="empty">Rennen konnten nicht geladen werden.</div>'}
})();
document.querySelector('.nav-toggle')?.addEventListener('click',()=>document.querySelector('.nav')?.classList.toggle('open'));
</script>

<div class="jackal-login-overlay" id="jackalLoginOverlay" aria-hidden="true">
  <div class="jackal-login-modal" role="dialog" aria-modal="true" aria-labelledby="jackalLoginTitle">
    <button class="jackal-login-close" id="jackalLoginClose" type="button" aria-label="Login schließen">×</button>
    <div class="jackal-login-kicker">JACKAL ADMIN</div>
    <h2 class="jackal-login-title" id="jackalLoginTitle">Anmelden</h2>
    <div class="jackal-login-sub">Melde dich an, um die Website zu verwalten.</div>
    <form class="jackal-login-form" id="jackalLoginForm">
      <div class="jackal-login-field">
        <label for="jackalLoginUsername">Benutzername</label>
        <input id="jackalLoginUsername" name="username" type="text" autocomplete="username" required>
      </div>
      <div class="jackal-login-field">
        <label for="jackalLoginPassword">Passwort</label>
        <input id="jackalLoginPassword" name="password" type="password" autocomplete="current-password" required>
      </div>
      <button class="jackal-login-submit" type="submit">ADMIN BEREICH ÖFFNEN</button>
      <div class="jackal-login-message" id="jackalLoginMessage"></div>
    </form>
    <div class="jackal-login-note">Der Login bleibt auf dieser Seite, bis du ihn absendest oder schließt.</div>
  </div>
</div>


<script id="jackalPublicLoginScript">
(function(){
  const button = document.querySelector('.login-link');
  const overlay = document.getElementById('jackalLoginOverlay');
  const close = document.getElementById('jackalLoginClose');
  const form = document.getElementById('jackalLoginForm');
  const message = document.getElementById('jackalLoginMessage');
  if(!button || !overlay || !form) return;

  const label = button.querySelector('span');
  let authenticated = false;

  function openLogin(){
    overlay.classList.add('open');
    overlay.setAttribute('aria-hidden','false');
    message.textContent = '';
    setTimeout(() => document.getElementById('jackalLoginUsername')?.focus(), 40);
  }
  function closeLogin(){
    overlay.classList.remove('open');
    overlay.setAttribute('aria-hidden','true');
    message.textContent = '';
  }

  async function refreshAuthState(){
    try{
      const r = await fetch('/api/me',{credentials:'same-origin',cache:'no-store'});
      authenticated = r.ok;
      button.classList.toggle('is-authenticated', authenticated);
      if(label) label.textContent = authenticated ? 'Admin' : 'Login';
      button.setAttribute('aria-label', authenticated ? 'Zum Admin-Bereich' : 'Zum Admin-Login');
    }catch(_){
      authenticated = false;
      button.classList.remove('is-authenticated');
      if(label) label.textContent = 'Login';
      button.setAttribute('aria-label','Zum Admin-Login');
    }
  }

  button.addEventListener('click', async event => {
    event.preventDefault();
    if(authenticated){
      window.location.href = '/admin';
      return;
    }
    openLogin();
  });

  close?.addEventListener('click', closeLogin);
  overlay.addEventListener('click', event => {
    if(event.target === overlay) closeLogin();
  });
  document.addEventListener('keydown', event => {
    if(event.key === 'Escape' && overlay.classList.contains('open')) closeLogin();
  });

  form.addEventListener('submit', async event => {
    event.preventDefault();
    const username = document.getElementById('jackalLoginUsername').value.trim();
    const password = document.getElementById('jackalLoginPassword').value;
    message.textContent = 'Anmeldung wird geprüft...';
    try{
      const r = await fetch('/api/login',{
        method:'POST',
        credentials:'same-origin',
        headers:{'Content-Type':'application/json'},
        body:JSON.stringify({username,password})
      });
      const d = await r.json().catch(() => ({}));
      if(!r.ok || !d.ok){
        message.textContent = d.error || 'Benutzername oder Passwort ist falsch.';
        return;
      }
      authenticated = true;
      if(label) label.textContent = 'Admin';
      button.classList.add('is-authenticated');
      document.getElementById('jackalLoginPassword').value = '';
      window.location.href = '/admin';
    }catch(_){
      message.textContent = 'Der Login-Server ist momentan nicht erreichbar.';
    }
  });

  refreshAuthState();
})();
</script>

</body>
</html>
