.lightbox {
  position: fixed; inset: 0; z-index: 100;
  display: flex; align-items: center; justify-content: center; gap: 18px;
  padding: 30px;
  background: rgba(5, 4, 10, .92);
  backdrop-filter: blur(6px);
}
.lightbox[hidden] { display: none; }
.lb-figure { margin: 0; width: min(1100px, 100%, (100vh - 150px) * 16 / 9); }
.lb-img { aspect-ratio: 16 / 9; border-radius: 6px; border: 1px solid #b266ff; box-shadow: 0 0 30px rgba(168, 85, 255, .6); }
.lb-img img { object-fit: contain; background: #000; cursor: default; }
.lb-figure figcaption { display: flex; align-items: baseline; gap: 14px; margin-top: 12px; }
.lb-figure strong { font-family: var(--f-head); font-style: italic; font-weight: 800; font-size: 24px; text-transform: uppercase; }
.lb-figure span { font-size: 14px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #d4cde8; }
.lb-close, .lb-nav {
  display: grid; place-items: center;
  width: 46px; height: 46px; flex-shrink: 0;
  color: #fff; background: rgba(14, 11, 26, .85); border: 1px solid var(--line); border-radius: 50%; cursor: pointer;
  transition: border-color .2s, box-shadow .2s;
}
.lb-close:hover, .lb-nav:hover { border-color: #b266ff; box-shadow: 0 0 14px rgba(168, 85, 255, .7); }
.lb-close svg, .lb-nav svg { width: 22px; height: 22px; }
.lb-close { position: absolute; top: 20px; right: 20px; }

@media (max-width: 1280px) { .g-grid { grid-template-columns: repeat(3, 1fr); } }
@media (max-width: 900px) {
  .g-grid { grid-template-columns: repeat(2, 1fr); }
  .g-tabs { width: 100%; overflow-x: auto; flex-wrap: nowrap; }
  .g-tab { padding: 0 16px; flex-shrink: 0; }
  .g-sort { margin-left: 0; width: 100%; }
  .g-sort select { width: 100%; }
}
@media (max-width: 560px) {
  .g-grid { grid-template-columns: 1fr; }
  .lightbox { padding: 70px 10px 20px; gap: 6px; }
  .lb-nav { position: absolute; bottom: 20px; }
  .lb-prev { left: calc(50% - 56px); }
  .lb-next { right: calc(50% - 56px); }
}

