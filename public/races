}
.filters select:focus { box-shadow: inset 0 0 0 1px #b266ff; }
.select-wrap { position: relative; }
.select-wrap svg { position: absolute; right: 12px; top: 50%; width: 16px; height: 16px; transform: translateY(-50%); color: #d4cde8; pointer-events: none; }

/* Fahrerkarten */
.drivers-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16px 18px;
  padding: 6px 22px 22px;
}
.driver-card {
  position: relative;
