.rt-results { padding: 4px 12px 12px; margin-top: 4px; border-top: 1px solid var(--line); }
.rt-results .tbl td { font-size: 14px; padding: 4px 8px; }
.rt-results .tbl .driver { font-size: 14px; text-transform: uppercase; }
.rt-results .tbl .time { font-size: 14px; font-weight: 500; }
