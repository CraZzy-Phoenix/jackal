<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Rangliste – Jackal Racing League</title>
<link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Saira+Condensed:wght@600;700;800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#07060d;--card:#110e1f;--card2:#171329;--line:#2a2342;--purple:#4e18ae;--accent:#b266ff;--neon:#a855ff;--text:#f2eefc;--muted:#a49cbc;--head:'Saira Condensed',sans-serif;--body:'Rajdhani',sans-serif;--brush:'Permanent Marker',cursive}
*{box-sizing:border-box;margin:0;padding:0}body{background:radial-gradient(1200px 500px at 50% 0,rgba(168,85,255,.12),transparent 60%),var(--bg);color:var(--text);font-family:var(--body);min-height:100vh}a{color:inherit;text-decoration:none}
.topbar{height:58px;position:sticky;top:0;z-index:50;display:flex;align-items:center;padding:0 36px;background:rgba(8,7,14,.94);border-bottom:1px solid var(--line)}.brand{font:30px var(--brush);text-transform:uppercase;text-shadow:0 0 12px rgba(178,102,255,.8),2px 2px 0 var(--purple)}.nav{position:absolute;left:50%;transform:translateX(-50%);display:flex}.nav a{padding:20px 15px;font-size:13px;font-weight:700;text-transform:uppercase;position:relative;color:#d9d3ec}.nav a:hover,.nav a.active{color:#fff}.nav a.active:after{content:"";position:absolute;left:10px;right:10px;bottom:5px;height:2px;background:var(--accent);box-shadow:0 0 10px var(--neon)}.nav-toggle{display:none;margin-left:auto;background:none;border:0}.nav-toggle span{display:block;width:24px;height:2px;background:#fff;margin:5px}
.hero{height:230px;position:relative;overflow:hidden;border-bottom:1px solid var(--line)}.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(to bottom,rgba(7,6,13,.15),rgba(7,6,13,.75),var(--bg))}.hero-content{position:relative;z-index:2;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center}.hero-title{font:88px var(--brush);background:linear-gradient(#f1e8ff,#b98cff,#7a3fe0);background-clip:text;-webkit-background-clip:text;color:transparent;transform:skew(-10deg)}.hero-sub{margin-top:8px;font-weight:700;text-transform:uppercase;letter-spacing:.4em}.hero-claim{color:var(--accent);font-style:italic;font-weight:700}
.page{max-width:1500px;margin:18px auto;padding:0 18px 35px}.card{background:linear-gradient(180deg,var(--card2),var(--card));border:1px solid var(--line);border-radius:10px;overflow:hidden}.head{padding:18px 20px;border-bottom:1px solid var(--line)}.head h2{font:700 32px var(--head);text-transform:uppercase}.head p{color:var(--accent);font-weight:600;text-transform:uppercase}
table{width:100%;border-collapse:separate;border-spacing:0 4px}.table{overflow:auto;padding:10px 15px 15px}th{text-align:left;padding:8px;font-size:12px;text-transform:uppercase;color:#d4cde8}td{padding:10px;background:rgba(255,255,255,.025)}tbody tr:hover td{background:rgba(168,85,255,.15)}.place{width:50px;text-align:center;font:bold 20px var(--head)}.gold{color:#f2c14e}.silver{color:#a6b2d6}.bronze{color:#f08a3c}.points{color:#f2c14e;font-weight:800}.empty{padding:30px;text-align:center;color:var(--muted);font-weight:700}
.footer{display:grid;grid-template-columns:1fr auto 1fr;gap:15px;padding:16px 40px;border-top:1px solid var(--line);font-weight:700;text-transform:uppercase;letter-spacing:.08em}.footer-center{font-family:var(--brush);color:var(--accent);text-align:center}.footer-right{text-align:right}
@media(min-width:1550px){.page{max-width:1550px}}@media(max-width:850px){.nav-toggle{display:block}.nav{display:none;left:0;right:0;top:58px;transform:none;flex-direction:column;background:rgba(8,7,14,.98)}.nav.open{display:flex}.nav a{padding:14px 24px}.footer{grid-template-columns:1fr;text-align:center}.footer-right{text-align:center}}
</style>
</head>
<body>
<header class="topbar">
<a href="/" class="brand">Jackal</a>
<button class="nav-toggle"><span></span><span></span><span></span></button>
<nav class="nav"><a href="/">Home</a><a href="/news">News</a><a href="/drivers">Drivers</a><a href="/rangliste" class="active">Rangliste</a><a href="/races">Races</a><a href="/blacklist">Blacklist</a><a href="/gallery">Gallery</a></nav>
</header>

<section class="hero"><img src="jackal-banner.png" alt=""><div class="hero-content"><h1 class="hero-title">Rangliste</h1><p class="hero-sub">Aktuelle Standings</p><p class="hero-claim">We are Jackal. We are racing.</p></div></section>

<main class="page">
<section class="card">
<div class="head"><h2>Rangliste</h2><p>Aktueller Stand der Jackal Racing League</p></div>
<div class="table">
<table>
<thead><tr><th>Platz</th><th>Fahrer</th><th>Team</th><th>Fahrzeug</th><th>Punkte</th><th>Siege</th><th>Rennen</th></tr></thead>
<tbody id="body"></tbody>
</table>
</div>
</section>
</main>

<footer class="footer"><span>Jackal Racing League</span><span class="footer-center">We are Jackal. We are racing.</span><span class="footer-right">Los Santos · Est. 2026</span></footer>

<script>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
(async()=>{
try{
const r=await fetch('/api/public/data',{cache:'no-store'}),d=await r.json();if(!d.ok)throw 0;
const rows=d.ranking||[];
body.innerHTML=rows.length?rows.map((x,i)=>{const p=Number(x.place)||i+1;let cls=p===1?'gold':p===2?'silver':p===3?'bronze':'';return `<tr><td class="place ${cls}">${p}</td><td><strong>${esc(x.name||x.nickname||'Unbekannt')}</strong></td><td>${esc(x.team||'—')}</td><td>${esc(x.car||'—')}</td><td class="points">${Number(x.points)||0}</td><td>${Number(x.wins)||0}</td><td>${Number(x.races)||0}</td></tr>`}).join(''):'<tr><td colspan="7" class="empty">Noch keine Rangliste vorhanden.</td></tr>';
}catch(e){body.innerHTML='<tr><td colspan="7" class="empty">Rangliste konnte nicht geladen werden.</td></tr>'}
})();
document.querySelector('.nav-toggle').onclick=()=>document.querySelector('.nav').classList.toggle('open');
</script>
</body>
</html>
