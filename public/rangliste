.g-sort { margin-left: auto; }
.g-sort select {
  appearance: none; height: 42px; width: 180px; padding: 0 40px 0 16px;
  font: 600 14px var(--f-body); text-transform: uppercase; letter-spacing: .03em;
  color: #fff; background: #0e0c1a; border: 1px solid #b266ff; border-radius: 4px; cursor: pointer; outline: none;
}

.g-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 12px 14px; }
.g-tile {
  position: relative; margin: 0;
  border: 1px solid #3a2a66; border-radius: 4px; overflow: hidden;
  transition: border-color .2s, box-shadow .2s;
}
.g-tile:hover { border-color: #b266ff; box-shadow: 0 0 18px rgba(168, 85, 255, .55); }
.g-img { aspect-ratio: 2 / 1.02; cursor: zoom-in; }
.g-img::after { border: 0; place-items: center; padding-bottom: 30px; }
.g-img img { transition: transform .4s; }
.g-tile:hover .g-img img { transform: scale(1.04); }
.g-tile figcaption {
  position: absolute; inset: auto 0 0 0; z-index: 2;
  display: flex; align-items: flex-end; gap: 6px;
  padding: 30px 12px 10px;
  background: linear-gradient(to bottom, transparent, rgba(8, 6, 16, .92));
  pointer-events: none;
}
.g-text { flex: 1; min-width: 0; }
.g-text strong { display: block; font-family: var(--f-head); font-style: italic; font-weight: 800; font-size: 17px; text-transform: uppercase; line-height: 1.1; }
.g-text span { display: block; margin-top: 3px; font-size: 12px; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; color: #d4cde8; }
.g-like, .g-full {
  pointer-events: auto;
  display: inline-flex; align-items: center; gap: 6px;
