<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Rangliste – Jackal Racing League</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Saira+Condensed:ital,wght@0,500;0,600;0,700;1,700;1,800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">

  <style>
/* =========================================================
   JACKAL RACING LEAGUE
   ========================================================= */

:root {
  --bg: #07060d;
  --bg-2: #0d0b18;
  --card: #110e1f;
  --card-2: #171329;
  --line: #2a2342;
  --line-glow: #4b2f8a;
  --purple: #4e18ae;      /* Hauptfarbe */
  --purple-2: #b266ff;    /* Neon-Lila für Text & Akzente */
  --purple-3: #dcbcff;
  --neon: #a855ff;        /* Leuchtfarbe */
  --text: #f2eefc;
  --muted: #a49cbc;
  --radius: 10px;

  --f-brush: 'Permanent Marker', cursive;
  --f-head: 'Saira Condensed', 'Arial Narrow', sans-serif;
  --f-body: 'Rajdhani', 'Segoe UI', sans-serif;
}

* { box-sizing: border-box; margin: 0; padding: 0; }

html, body { background: var(--bg); }

body {
  color: var(--text);
  font-family: var(--f-body);
  font-size: 16px;
  line-height: 1.4;
  background:
    radial-gradient(1200px 500px at 50% 0%, rgba(168, 85, 255, .12), transparent 60%),
    var(--bg);
  min-height: 100vh;
}

a { color: inherit; text-decoration: none; }

/* ---------- Image placeholder system ----------
   Jede Bildfläche ist ein .img-slot. Solange die Datei in /images
   fehlt, wird ein Platzhalter mit Dateinamen angezeigt. Sobald die
   Datei existiert, erscheint automatisch das Bild.                  */
.img-slot {
  position: relative;
  overflow: hidden;
  background:
    repeating-linear-gradient(135deg, rgba(168, 85, 255, .07) 0 12px, transparent 12px 24px),
    linear-gradient(160deg, #1a1430, #0c0a16);
}
.img-slot::after {
  content: attr(data-label);
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  padding: 8px;
  text-align: center;
  font: 600 12px/1.2 var(--f-body);
  letter-spacing: .08em;
  text-transform: uppercase;
  color: rgba(201, 164, 255, .55);
  border: 1px dashed rgba(168, 85, 255, .35);
  border-radius: inherit;
  pointer-events: none;
}
.img-slot img {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  object-fit: cover;
  z-index: 1;
}
.img-slot.loaded { background: none; }
.img-slot.loaded::after { display: none; }
.img-slot.missing img { display: none; }

/* ---------- Topbar ---------- */
.topbar {
  position: sticky;
  top: 0;
  z-index: 50;
  display: flex;
  align-items: center;
  gap: 24px;
  height: 56px;
  padding: 0 40px;
  background: rgba(8, 7, 14, .92);
  backdrop-filter: blur(8px);
  border-bottom: 1px solid var(--line);
}

.brand { display: flex; align-items: center; gap: 10px; }
.brand-slot { display: none; width: 110px; height: 40px; }
.brand-slot.loaded { display: block; }
.brand-slot.loaded img { object-fit: contain; }
.brand-slot.loaded + .brand-text { display: none; }
.brand-text {
  font-family: var(--f-brush);
  font-size: 30px;
  text-transform: uppercase;
  color: #fff;
  transform: skew(-8deg);
  text-shadow: 0 0 12px rgba(178, 102, 255, .8), 2px 2px 0 var(--purple);
}

.nav {
  display: flex;
  gap: 8px;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}
.nav a {
  position: relative;
  padding: 18px 16px;
  font-family: var(--f-body);
  font-weight: 600;
  font-size: 13px;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: #d9d3ec;
  transition: color .2s;
}
.nav a:hover { color: #fff; }
.nav a.active { color: #fff; }
.nav a.active::after {
  content: "";
  position: absolute;
  left: 10px; right: 10px; bottom: 4px;
  height: 2px;
  background: var(--purple-2);
  box-shadow: 0 0 10px var(--purple), 0 0 2px #fff;
}


.nav-toggle {
  display: none;
  margin-left: auto;
  background: none;
  border: 0;
  cursor: pointer;
  padding: 8px;
}
.nav-toggle span {
  display: block;
  width: 24px; height: 2px;
  margin: 5px 0;
  background: #fff;
}

/* ---------- Hero ---------- */
.hero {
  position: relative;
  height: 320px;
  overflow: hidden;
  border-bottom: 1px solid var(--line);
}
.hero-bg { position: absolute; inset: 0; z-index: 1; }
.hero-bg::after { border: 0; place-items: end center; padding-bottom: 18px; }
.hero-overlay {
  position: absolute;
  inset: 0;
  z-index: 2;
  background:
    radial-gradient(ellipse at 50% 45%, rgba(10, 6, 22, .15), rgba(7, 6, 13, .55) 75%),
    linear-gradient(to bottom, transparent 70%, var(--bg));
  pointer-events: none;
}
.hero-content {
  position: relative;
  z-index: 3;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding-bottom: 30px;
}
.hero-logo-slot { display: none; width: min(420px, 80vw); height: 230px; background: none; }
.hero-logo-slot::after { display: none; }
.hero-logo-slot img { object-fit: contain; }
.hero-logo-slot.loaded { display: block; }
.hero-logo-slot.loaded ~ .hero-title,
.hero-logo-slot.loaded ~ .hero-sub,
.hero-logo-slot.loaded ~ .hero-claim { display: none; }

.hero-title {
  font-family: var(--f-brush);
  font-weight: 400;
  font-size: clamp(64px, 11vw, 140px);
  line-height: .9;
  text-transform: uppercase;
  color: #ecebf2;
  transform: skew(-10deg) rotate(-3deg);
  text-shadow:
    4px 4px 0 var(--purple),
    0 0 30px rgba(168, 85, 255, .9),
    0 0 60px rgba(168, 85, 255, .5);
}
.hero-sub {
  margin-top: 6px;
  font-family: var(--f-body);
  font-weight: 600;
  font-size: clamp(16px, 2.4vw, 24px);
  letter-spacing: .45em;
  text-transform: uppercase;
  color: #fff;
}
.hero-claim {
  margin-top: 4px;
  font-family: var(--f-head);
  font-style: italic;
  font-weight: 700;
  font-size: clamp(13px, 1.6vw, 17px);
  letter-spacing: .08em;
  text-transform: uppercase;
  color: var(--purple-2);
  text-shadow: 0 0 10px rgba(168, 85, 255, .7);
}

/* ---------- Grid ---------- */
.grid {
  display: grid;
  grid-template-columns: 2fr 1fr;
  gap: 18px;
  max-width: 1240px;
  margin: 6px auto 0;
  padding: 0 18px 30px;
  position: relative;
  z-index: 5;
}

.card {
  position: relative;
  background: linear-gradient(180deg, var(--card-2), var(--card));
  border: 1px solid var(--line);
  border-radius: var(--radius);
  overflow: hidden;
  box-shadow: 0 10px 30px rgba(0, 0, 0, .45), inset 0 1px 0 rgba(255, 255, 255, .03);
}

/* Card heads */
.card-head {
  position: relative;
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px 16px;
}
.card-head-band {
  background: linear-gradient(100deg, rgba(168, 85, 255, .14), transparent 45%);
  border-bottom: 1px solid var(--line);
}
.head-icon {
  width: 26px; height: 26px;
  flex-shrink: 0;
  color: var(--purple-2);
  filter: drop-shadow(0 0 6px rgba(168, 85, 255, .6));
}
.head-title {
  font-family: var(--f-head);
  font-style: italic;
  font-weight: 800;
  font-size: 22px;
  letter-spacing: .02em;
  text-transform: uppercase;
  color: #fff;
  line-height: 1;
}
.head-title-lg { font-size: 24px; white-space: nowrap; }
.head-sub {
  margin-top: 4px;
  font-size: 12px;
  font-weight: 600;
  letter-spacing: .06em;
  text-transform: uppercase;
  color: var(--muted);
}
.head-chevron {
  margin-left: auto;
  display: flex;
  color: var(--muted);
  transition: color .2s, transform .2s;
}
.head-chevron svg { width: 20px; height: 20px; }
.head-chevron { flex-shrink: 0; }
.head-title-lg { min-width: 0; overflow: hidden; text-overflow: ellipsis; }
.head-chevron:hover { color: #fff; transform: translateX(3px); }

/* ---------- Next Race ---------- */
.next-race { min-height: 300px; }
.next-race-bg { position: absolute; inset: 0; }
.next-race-bg::after { border: 0; place-items: center end; padding-right: 15%; }
.next-race-fade {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(90deg, rgba(10, 8, 20, .97) 0%, rgba(10, 8, 20, .85) 32%, rgba(10, 8, 20, .1) 65%, transparent);
  pointer-events: none;
}
.next-race-content {
  position: relative;
  z-index: 3;
  padding: 18px 32px 26px;
  max-width: 420px;
}
.brush {
  font-family: var(--f-brush);
  font-weight: 400;
  text-transform: uppercase;
  line-height: 1;
  transform: skew(-8deg);
}
.next-race h2.brush {
  font-size: 40px;
  color: #ecebf2;
  text-shadow: 3px 3px 0 rgba(168, 85, 255, .55), 0 0 18px rgba(168, 85, 255, .35);
}
.brush-purple {
  margin-top: 4px;
  font-size: 24px;
  color: var(--purple-2);
  text-shadow: 0 0 14px rgba(168, 85, 255, .6);
}

.race-info { list-style: none; margin: 18px 0 22px; display: grid; gap: 12px; }
.race-info li { display: flex; align-items: center; gap: 16px; }
.race-info svg {
  width: 26px; height: 26px;
  flex-shrink: 0;
  color: var(--purple-2);
  fill: var(--purple-2);
}
.race-info svg[fill="none"] { fill: none; }
.race-info strong {
  display: block;
  font-weight: 600;
  font-size: 18px;
  text-transform: uppercase;
  letter-spacing: .02em;
}
.race-info small {
  display: block;
  font-size: 13px;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--muted);
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  min-width: 220px;
  height: 48px;
  padding: 0 14px 0 24px;
  font-family: var(--f-head);
  font-weight: 600;
  font-size: 20px;
  letter-spacing: .02em;
  text-transform: uppercase;
  color: #fff;
  background: linear-gradient(180deg, #5c22c4 0%, var(--purple) 55%, #43149a 100%);
  border: 1px solid #b266ff;
  border-radius: 3px;
  box-shadow:
    0 0 18px rgba(168, 85, 255, .9),
    0 0 40px rgba(168, 85, 255, .45),
    inset 0 1px 0 rgba(255, 255, 255, .18),
    inset 0 0 0 1px rgba(255, 255, 255, .04);
  transition: box-shadow .2s, filter .2s;
}
.btn:hover {
  filter: brightness(1.12);
  box-shadow:
    0 0 24px rgba(178, 102, 255, .8),
    0 0 50px rgba(168, 85, 255, .6),
    inset 0 1px 0 rgba(255, 255, 255, .22);
}
.btn-arrow { width: 18px; height: 18px; flex-shrink: 0; }

/* ---------- Side stack ---------- */
.side-stack { display: grid; gap: 12px; grid-template-rows: auto 1fr; }

.countdown .card-head { padding-bottom: 8px; }
.cd-boxes {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;
  padding: 2px 14px 14px;
}
.cd-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10px 4px 8px;
  background: linear-gradient(180deg, #1a1530, #120f22);
  border: 1px solid var(--line);
  border-radius: 6px;
}
.cd-box span {
  font-family: var(--f-head);
  font-weight: 600;
  font-size: 34px;
  line-height: 1;
  color: var(--purple-2);
  text-shadow: 0 0 14px rgba(168, 85, 255, .6);
  font-variant-numeric: tabular-nums;
}
.cd-box small {
  margin-top: 6px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: #d4cde8;
}

.location { min-height: 130px; padding: 6px; }
.location-img { position: absolute; inset: 6px; border-radius: 6px; }
.location-img::after { place-items: end; padding: 12px 16px; }
.location-text {
  position: relative;
  z-index: 2;
  padding: 12px 14px;
  background: linear-gradient(180deg, rgba(10, 8, 20, .75), transparent);
  border-radius: 6px 6px 0 0;
}
.location .head-title { font-size: 20px; }

/* ---------- News ---------- */
.news .card-head { padding: 10px 16px; }
.link-all {
  margin-left: auto;
  font-size: 13px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: #e6e1f5;
  transition: color .2s;
}
.link-all, .more { display: inline-flex; align-items: center; gap: 8px; }
.arr { width: 15px; height: 15px; color: var(--purple-2); transition: transform .2s; }
.link-all:hover .arr, .more:hover .arr { transform: translateX(3px); }
.link-all:hover { color: var(--purple-3); }

.news-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 14px;
  padding: 12px 14px 14px;
}
.news-item {
  background: #0e0c1a;
  border: 1px solid var(--line);
  border-radius: 6px;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  transition: border-color .2s, transform .2s;
}
.news-item:hover { border-color: var(--line-glow); transform: translateY(-2px); }
.news-img { aspect-ratio: 2 / 1; }
.news-body { padding: 10px 10px 10px; display: flex; flex-direction: column; flex: 1; }
.news-body time { font-size: 12px; font-weight: 600; color: var(--purple-2); }
.news-body h3 {
  margin-top: 2px;
  font-family: var(--f-body);
  font-weight: 700;
  font-size: 16px;
  text-transform: uppercase;
  letter-spacing: .02em;
}
.news-body p { margin-top: 4px; font-size: 13px; font-weight: 500; color: #cfc8e2; flex: 1; }
.more {
  align-self: flex-start;
  margin-top: 12px;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: .04em;
  text-transform: uppercase;
  color: var(--purple-2);
}
.more:hover { color: var(--purple-3); }

/* ---------- Champion ---------- */
.champion { display: flex; flex-direction: column; }
.champion .card-head {
  background: linear-gradient(100deg, rgba(168, 85, 255, .14), transparent 55%);
  border-bottom: 1px solid var(--line);
}
.champion-stage {
  position: relative;
  flex: 1;
  min-height: 180px;
  margin: 8px 8px 0;
  border-radius: 6px;
  overflow: hidden;
}
.champion-bg { position: absolute; inset: 0; }
.champion-bg::after { border: 0; place-items: end end; padding: 10px 14px; }
.champion-fade {
  position: absolute;
  inset: 0;
  z-index: 2;
  background: linear-gradient(90deg, rgba(10, 8, 20, .7), transparent 60%);
  pointer-events: none;
}
.champion-info {
  position: absolute;
  z-index: 3;
  left: 12px;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  align-items: center;
  gap: 14px;
}
.champion-avatar {
  width: 72px;
  height: 108px;
  border: 1.5px solid #d4a640;
  border-radius: 6px;
  box-shadow: 0 0 16px rgba(212, 166, 64, .35);
  background-color: #0b0a12;
}
.champion-avatar::after { font-size: 9px; border: 0; }
.champion-stats { display: flex; flex-direction: column; }
.champion-stats .rank {
  font-family: var(--f-head);
  font-weight: 800;
  font-size: 22px;
  line-height: 1;
  color: #f2c14e;
  text-shadow: 0 0 10px rgba(242, 193, 78, .45);
}
.champion-stats .name {
  font-family: var(--f-head);
  font-weight: 700;
  font-size: 26px;
  line-height: 1.1;
  text-transform: uppercase;
}
.champion-stats .pts {
  font-family: var(--f-head);
  font-weight: 600;
  font-size: 19px;
  text-transform: uppercase;
}

.champion-car {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin: 8px;
  padding: 6px 6px 6px 12px;
  background: #0e0c1a;
  border: 1px solid var(--line);
  border-radius: 6px;
}
.champion-car small {
  display: block;
  font-size: 12px;
  font-weight: 600;
  text-transform: uppercase;
  color: var(--muted);
}
.champion-car strong {
  display: block;
  font-weight: 700;
  font-size: 16px;
  text-transform: uppercase;
}
.champion .head-title-lg { font-size: 22px; }
.car-thumb { width: 104px; height: 54px; border-radius: 4px; flex-shrink: 0; }
.car-thumb::after { font-size: 9px; }

/* ---------- Footer ---------- */
.footer {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  align-items: center;
  gap: 16px;
  padding: 14px 48px;
  font-size: 14px;
  font-weight: 600;
  letter-spacing: .08em;
  text-transform: uppercase;
  color: #d4cde8;
  border-top: 1px solid var(--line);
  background: rgba(8, 7, 14, .6);
}
.footer-claim {
  font-family: var(--f-brush);
  font-size: 15px;
  letter-spacing: .02em;
  color: var(--purple-2);
  transform: skew(-8deg);
  text-shadow: 0 0 10px rgba(168, 85, 255, .8);
}
.footer > :last-child { text-align: right; }
@media (max-width: 760px) {
  .footer { grid-template-columns: 1fr; text-align: center; padding: 16px; gap: 6px; }
  .footer > :last-child { text-align: center; }
}

/* ---------- Responsive ---------- */
@media (max-width: 1100px) {
  .topbar { padding: 0 20px; }
  .nav a { padding: 20px 10px; font-size: 13px; }
}

@media (max-width: 960px) {
  .grid { grid-template-columns: 1fr; }
  .nav-toggle { display: block; }
    .nav {
    position: absolute;
    top: 56px; left: 0; right: 0;
    transform: none;
    flex-direction: column;
    gap: 0;
    background: rgba(8, 7, 14, .98);
    border-bottom: 1px solid var(--line);
    display: none;
  }
  .nav.open { display: flex; }
  .nav a { padding: 14px 24px; }
  .nav a.active::after { left: 0; right: auto; top: 10px; bottom: 10px; width: 3px; height: auto; }
}

@media (max-width: 640px) {
  .topbar { padding: 0 16px; }
  .hero { height: 260px; }
  .grid { padding: 0 16px 24px; }
  .next-race-content { padding: 20px; }
  .next-race-fade { background: linear-gradient(90deg, rgba(10, 8, 20, .95), rgba(10, 8, 20, .7)); }
  .next-race h2.brush { font-size: 36px; }
  .news-list { grid-template-columns: 1fr; }
  .cd-box span { font-size: 30px; }
  .cd-box small { font-size: 10px; }
  .btn { min-width: 0; width: 100%; }
  .head-title-lg { font-size: 22px; }
  .link-all { white-space: nowrap; font-size: 12px; }
}
/* Team-Logos (Platzhalter = Initiale in Teamfarbe) */
.team-ico {
  display: inline-block;
  width: 20px; height: 20px;
  border-radius: 50%;
  vertical-align: middle;
  flex-shrink: 0;
  background: rgba(255, 255, 255, .06);
}
.team-ico::after {
  border: 1px solid currentColor;
  border-radius: 50%;
  padding: 0;
  font: 700 10px/1 var(--f-body);
  letter-spacing: 0;
  color: inherit;
}
.team-ico img { object-fit: contain; }
.team { font-size: 14px; font-weight: 600; text-transform: uppercase; }
.team > span { display: inline-flex; align-items: center; gap: 10px; }
.t-jackal { color: #ff3d8b; }
.t-nightshift { color: #4d86ff; }
.t-velocity { color: #ff4040; }
.t-phantom { color: #8f8cff; }


/* =========================================================
   DRIVERS-SEITE
   ========================================================= */
.hero-page { height: 230px; }
.hero-page .hero-content { padding-bottom: 10px; }
.page-title {
  font-family: var(--f-brush);
  font-weight: 400;
  font-size: clamp(56px, 9.5vw, 124px);
  line-height: .95;
  text-transform: uppercase;
  color: #b98cff;
  background: linear-gradient(180deg, #f1e8ff 0%, #b98cff 45%, #7a3fe0 100%);
  -webkit-background-clip: text;
  background-clip: text;
  -webkit-text-fill-color: transparent;
  transform: skew(-12deg) rotate(-2deg);
  filter: drop-shadow(0 0 18px rgba(168, 85, 255, .95)) drop-shadow(4px 4px 0 var(--purple));
}
.hero-page .hero-sub { margin-top: 12px; font-size: clamp(13px, 1.8vw, 20px); letter-spacing: .55em; }

.wrap-page {
  max-width: 1460px;
  margin: 12px auto 0;
  padding: 0 18px 24px;
  position: relative;
  z-index: 5;
  display: grid;
  gap: 18px;
}

/* Kopf mit Suche + Filtern */
.drivers-head {
  display: flex;
  align-items: center;
  gap: 18px;
  padding: 14px 22px;
  flex-wrap: wrap;
}
.drivers-head .big-icon { width: 50px; height: 50px; color: var(--purple-2); filter: drop-shadow(0 0 10px rgba(168, 85, 255, .9)); flex-shrink: 0; }
.drivers-head .title {
