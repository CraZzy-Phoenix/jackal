}
.tools { display: flex; gap: 14px; margin-left: auto; flex-wrap: wrap; }
.search {
  position: relative;
  width: 300px;
}
.search input {
  width: 100%;
  height: 42px;
  padding: 0 42px 0 16px;
  font: 500 15px var(--f-body);
  color: #fff;
  background: #0e0c1a;
  border: 1px solid var(--line);
