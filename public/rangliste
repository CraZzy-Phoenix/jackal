/* =========================================================
   GALLERY
   ========================================================= */
.g-bar { display: flex; align-items: center; gap: 16px; flex-wrap: wrap; }
.g-tabs { display: flex; flex-wrap: wrap; align-items: center; }
.g-tab {
  display: inline-flex; align-items: center; gap: 12px;
  height: 44px; padding: 0 26px;
  font: 600 14px var(--f-body); letter-spacing: .04em; text-transform: uppercase;
  color: #e6e1f5; background: none; border: 1px solid transparent; border-radius: 4px; cursor: pointer;
  position: relative;
  transition: color .2s, background .2s;
}
.g-tab + .g-tab::before { content: ""; position: absolute; left: 0; top: 12px; bottom: 12px; width: 1px; background: var(--line); }
.g-tab svg { width: 20px; height: 20px; color: #d4cde8; }
