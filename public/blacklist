}
.search input::placeholder { color: #a49cbc; }
.search input:focus { border-color: #b266ff; box-shadow: 0 0 10px rgba(168, 85, 255, .6); }
.search svg { position: absolute; right: 12px; top: 50%; width: 20px; height: 20px; transform: translateY(-50%); color: #d4cde8; pointer-events: none; }

.filters { display: flex; border: 1px solid var(--line); border-radius: 4px; overflow: hidden; }
.filters .select-wrap { margin: 0; align-self: auto; }
.filters .select-wrap + .select-wrap { border-left: 1px solid var(--line); }
.filters select {
  appearance: none;
  height: 40px;
  width: 156px;
  padding: 0 38px 0 16px;
  font: 600 14px var(--f-body);
  text-transform: uppercase;
  color: #fff;
  background: #0e0c1a;
  border: 0;
  cursor: pointer;
  outline: none;
}
.filters .select-wrap:first-child select {
  background: linear-gradient(180deg, #2a1360, #1c0d42);
