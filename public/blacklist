.tbl .driver { font-weight: 700; font-size: 16px; }
.tbl .driver > span { display: inline-flex; align-items: center; gap: 10px; }
.tbl .time { font-weight: 600; font-size: 16px; font-variant-numeric: tabular-nums; }
.tbl .pts { font-weight: 700; color: #f2c14e; text-align: right; }
