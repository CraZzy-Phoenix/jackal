}
.pos-1 { background: linear-gradient(180deg, #f6c84a, #c98d14); color: #241500; }
.pos-2 { background: linear-gradient(180deg, #a6b2d6, #6a76a0); color: #10131f; }
.pos-3 { background: linear-gradient(180deg, #f08a3c, #b4531a); color: #220c00; }

/* Kleiner Button – gleicher Stil wie .btn */
.btn-sm {
  min-width: 0;
  height: 34px;
  gap: 10px;
  padding: 0 12px 0 14px;
  font-size: 15px;
  background: linear-gradient(180deg, #2a1360, #1c0d42);
  box-shadow: 0 0 12px rgba(168, 85, 255, .6), inset 0 1px 0 rgba(255, 255, 255, .1);
}
.btn-sm .btn-arrow { width: 15px; height: 15px; }
.btn .btn-arrow.arrow-right { width: 18px; }


/* =========================================================
   GEMEINSAM: Seitenkopf ohne Karte, Chips, Filter-Logik
   ========================================================= */
.page-head { padding: 6px 4px 0; }
.page-head .title { font-size: 28px; }
.chip {
  display: inline-flex;
  align-items: center;
  height: 26px;
  padding: 0 10px;
  font-size: 14px;
  font-weight: 600;
  color: #e6e1f5;
  border: 1px solid var(--line);
  border-radius: 3px;
  background: rgba(14, 11, 26, .6);
  white-space: nowrap;
}
.chip-type { color: var(--purple-2); }
.chips { display: flex; flex-wrap: wrap; gap: 8px; }
.filter-empty { grid-column: 1 / -1; padding: 30px; text-align: center; color: #a49cbc; font-weight: 600; text-transform: uppercase; display: none; }

/* =========================================================
   RACES
   ========================================================= */
.races-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px 18px; }
.race-tile { display: flex; flex-direction: column; transition: border-color .2s, box-shadow .2s; }
.race-tile:hover { border-color: #b266ff; box-shadow: 0 0 18px rgba(168, 85, 255, .5); }
.rt-top { position: relative; }
.rt-img { height: 150px; margin: 6px 6px 0; border-radius: 4px; }
.rt-img::after { place-items: center end; padding-right: 18px; border: 0; }
.rt-top::after {
  content: ""; position: absolute; left: 6px; right: 6px; bottom: 0; height: 70px; z-index: 2; pointer-events: none;
  background: linear-gradient(to bottom, transparent, var(--card-2));
}
