.bl-body { position: relative; z-index: 3; margin-top: -18px; padding: 0 12px 14px; display: flex; flex-direction: column; flex: 1; }
.bl-name { font-family: var(--f-head); font-style: italic; font-weight: 800; font-size: 20px; text-transform: uppercase; }
