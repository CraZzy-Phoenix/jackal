<script>
(function(){

function escapeHtml(value){
  return String(value ?? '')
    .replace(/&/g,'&amp;')
    .replace(/</g,'&lt;')
    .replace(/>/g,'&gt;')
    .replace(/"/g,'&quot;')
    .replace(/'/g,'&#039;');
}

function imageSlot(url, label, alt='', cls=''){
  if(url){
    return `<div class="img-slot ${cls}" data-label="${escapeHtml(label)}"><img src="${escapeHtml(url)}" alt="${escapeHtml(alt)}"></div>`;
  }
  return `<div class="img-slot ${cls}" data-label="${escapeHtml(label)}"></div>`;
}

function wireImageSlots(root=document){
  root.querySelectorAll('.img-slot img').forEach(function(img){
    var slot = img.closest('.img-slot');
    function ok(){ if(slot){ slot.classList.add('loaded'); slot.classList.remove('missing'); } }
    function fail(){ if(slot){ slot.classList.add('missing'); slot.classList.remove('loaded'); } }
    if(img.complete) img.naturalWidth > 0 ? ok() : fail();
    img.addEventListener('load', ok);
    img.addEventListener('error', fail);
  });
}

async function loadJackalData(){
  if(window.__JACKAL_DATA_PROMISE) return window.__JACKAL_DATA_PROMISE;
  window.__JACKAL_DATA_PROMISE = fetch('/api/public/data', {cache:'no-store'})
    .then(function(r){ if(!r.ok) throw new Error('Website-Daten konnten nicht geladen werden.'); return r.json(); })
    .then(function(d){ if(!d.ok) throw new Error(d.error || 'Website-Daten konnten nicht geladen werden.'); window.__JACKAL_DATA=d; return d; });
  return window.__JACKAL_DATA_PROMISE;
}

function raceDateTime(race){
  if(!race || !race.date) return null;
  var time = race.time || '00:00';
  var d = new Date(String(race.date).slice(0,10) + 'T' + String(time).slice(0,5) + ':00');
  return isNaN(d.getTime()) ? null : d;
}

function formatDateDe(value){
  if(!value) return '—';
  var raw=String(value).slice(0,10);
  var m=raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if(!m) return String(value);
  return `${m[3]}.${m[2]}.${m[1]}`;
}

function formatDateShort(value){
  if(!value) return '—';
  var raw=String(value).slice(0,10);
  var m=raw.match(/^(\d{4})-(\d{2})-(\d{2})$/);
  if(!m) return String(value);
  var months=['Jan','Feb','Mär','Apr','Mai','Jun','Jul','Aug','Sep','Okt','Nov','Dez'];
  return `${m[3]}. ${months[Number(m[2])-1] || m[2]} ${m[1]}`;
}

function isPastRace(race){
  var d=raceDateTime(race);
  return d ? d.getTime() < Date.now() : !Number(race && race.is_next);
}

function driverMap(data){
  var map=new Map();
  (data.drivers || []).forEach(function(d){ map.set(String(d.id),d); });
  return map;
}

  function render(data){
    var grid=document.querySelector('.bl-grid'); if(!grid)return;
    var rows=(data.blacklist||[]).slice();
    var brandSelect=grid.parentElement?.previousElementSibling?.querySelector('select[data-key="brand"]') || document.querySelector('select[data-key="brand"]');
    var clsSelect=document.querySelector('select[data-key="cls"]');
    var reasonSelect=document.querySelector('select[data-key="reason"]');
    if(brandSelect){brandSelect.innerHTML='<option value="">Alle Hersteller</option>';[...new Set(rows.map(function(r){return String(r.vehicle_name||'').trim().split(/\\s+/)[0];}).filter(Boolean))].sort().forEach(function(v){brandSelect.add(new Option(v,v));});}
    if(clsSelect){clsSelect.innerHTML='<option value="">Alle Klassen</option>';clsSelect.disabled=true;}
    if(reasonSelect){reasonSelect.innerHTML='<option value="">Alle Gründe</option>';[...new Set(rows.flatMap(function(r){return String(r.reason||'').split(/[|\\n,]/).map(function(x){return x.trim();}).filter(Boolean);} ))].sort().forEach(function(v){reasonSelect.add(new Option(v,v));});}
    grid.innerHTML=rows.length?rows.map(function(r,i){var name=String(r.vehicle_name||'Unbekanntes Fahrzeug');var brand=name.trim().split(/\\s+/)[0]||'—';var model=name.replace(new RegExp('^'+brand+'\\\\s*','i'),'')||name;var reasons=String(r.reason||'').split(/[|\\n,]/).map(function(x){return x.trim();}).filter(Boolean);var num=String(i+1).padStart(3,'0');return `<article class="card bl-card" data-brand="${escapeHtml(brand)}" data-cls="" data-item data-reason="${escapeHtml(reasons.join('|'))}" data-search="${escapeHtml((name+' '+r.reason).toLowerCase())}"><div class="bl-top">${imageSlot(r.image_url,'blacklist-'+num+'.jpg',name,'bl-img')}<span class="bl-num">#${num}</span><span class="bl-brand"><span class="img-slot brand-ico" data-label="${escapeHtml(brand[0]||'B')}"></span>${escapeHtml(brand)}</span><span class="bl-class">—</span></div><div class="bl-body"><h2 class="bl-name">${escapeHtml(model)}</h2><p class="bl-reason-label">Grund der Sperre:</p><div class="chips">${reasons.map(function(x){return `<span class="chip">${escapeHtml(x)}</span>`;}).join('') || '<span class="chip">Keine Angabe</span>'}</div><span class="btn btn-sm">Blacklist-Eintrag <svg class="btn-arrow arrow-right" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M4 12h15M13 6l6 6-6 6"/></svg></span></div></article>`;}).join(''):'<p class="filter-empty" style="display:block">Keine Fahrzeuge auf der Blacklist.</p>';
    var search=document.querySelector('[data-filter-search]');function apply(){var q=(search?.value||'').trim().toLowerCase();var shown=0;grid.querySelectorAll('[data-item]').forEach(function(el){var ok=!q||el.dataset.search.includes(q);if(brandSelect?.value)ok=ok&&el.dataset.brand===brandSelect.value;if(reasonSelect?.value)ok=ok&&el.dataset.reason.split('|').includes(reasonSelect.value);el.style.display=ok?'':'none';if(ok)shown++;});var empty=grid.querySelector('.filter-empty');if(empty)empty.style.display=shown?'none':'block';} [search,brandSelect,reasonSelect].filter(Boolean).forEach(function(el){el.oninput=apply;el.onchange=apply;});apply();
    var stats=document.querySelector('.stats-bar');if(stats){var s=stats.querySelectorAll('.stat b');if(s[0])s[0].textContent=rows.length;if(s[1])s[1].textContent=new Set(rows.map(function(r){return String(r.vehicle_name||'').trim().split(/\\s+/)[0];}).filter(Boolean)).size;if(s[2])s[2].textContent='—';if(s[3])s[3].textContent=0;}
    wireImageSlots(grid);
  }
  function init(){loadJackalData().then(render).catch(console.error);wireImageSlots();}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();
})();
</script>

