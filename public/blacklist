/* =========================================================
   BLACKLIST
   ========================================================= */
.bl-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 14px; padding: 4px 0 0; }
.bl-card { display: flex; flex-direction: column; border-color: #3a2a66; transition: border-color .2s, box-shadow .2s, transform .2s; }
.bl-card:hover { border-color: #b266ff; box-shadow: 0 0 18px rgba(168, 85, 255, .55); transform: translateY(-2px); }
.bl-top { position: relative; }
.bl-img { height: 150px; }
.bl-img::after { border: 0; place-items: end center; padding-bottom: 26px; }
.bl-top::after {
  content: ""; position: absolute; inset: auto 0 0 0; height: 60px; z-index: 2; pointer-events: none;
  background: linear-gradient(to bottom, transparent, var(--card-2));
}
.bl-num {
  position: absolute; top: 0; left: 0; z-index: 3;
  padding: 8px 14px;
  font-family: var(--f-head); font-weight: 700; font-size: 22px; line-height: 1;
