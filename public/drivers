<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Drivers – Jackal Racing League</title>
<link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Saira+Condensed:wght@600;700;800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#07060d;--card:#110e1f;--card2:#171329;--line:#2a2342;--purple:#4e18ae;--accent:#b266ff;--neon:#a855ff;--text:#f2eefc;--muted:#a49cbc;--head:'Saira Condensed',sans-serif;--body:'Rajdhani',sans-serif;--brush:'Permanent Marker',cursive}
*{box-sizing:border-box;margin:0;padding:0}
body{background:radial-gradient(1200px 500px at 50% 0,rgba(168,85,255,.12),transparent 60%),var(--bg);color:var(--text);font-family:var(--body);min-height:100vh}
a{color:inherit;text-decoration:none}
.topbar{height:58px;position:sticky;top:0;z-index:50;display:flex;align-items:center;padding:0 36px;background:rgba(8,7,14,.94);border-bottom:1px solid var(--line);backdrop-filter:blur(8px)}
.brand{font:30px var(--brush);text-transform:uppercase;text-shadow:0 0 12px rgba(178,102,255,.8),2px 2px 0 var(--purple)}
.nav{position:absolute;left:50%;transform:translateX(-50%);display:flex}.nav a{padding:20px 15px;font-size:13px;font-weight:700;text-transform:uppercase;position:relative;color:#d9d3ec}.nav a:hover,.nav a.active{color:#fff}.nav a.active:after{content:"";position:absolute;left:10px;right:10px;bottom:5px;height:2px;background:var(--accent);box-shadow:0 0 10px var(--neon)}
.nav-toggle{display:none;margin-left:auto;background:none;border:0}.nav-toggle span{display:block;width:24px;height:2px;background:#fff;margin:5px}
.hero{height:230px;position:relative;overflow:hidden;border-bottom:1px solid var(--line)}.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(to bottom,rgba(7,6,13,.2),rgba(7,6,13,.7),var(--bg))}
.hero-content{position:relative;z-index:2;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center}.hero-title{font:88px var(--brush);background:linear-gradient(#f1e8ff,#b98cff,#7a3fe0);background-clip:text;-webkit-background-clip:text;color:transparent;transform:skew(-10deg)}.hero-sub{font-weight:700;text-transform:uppercase;letter-spacing:.4em;margin-top:8px}.hero-claim{color:var(--accent);font-style:italic;font-weight:700}
.page{max-width:1500px;margin:18px auto;padding:0 18px 35px}.card{background:linear-gradient(180deg,var(--card2),var(--card));border:1px solid var(--line);border-radius:10px;overflow:hidden}
.head{padding:18px 20px;border-bottom:1px solid var(--line);background:linear-gradient(100deg,rgba(168,85,255,.13),transparent 55%)}.head h2{font:700 30px var(--head);text-transform:uppercase}.head p{color:var(--accent);font-weight:600;text-transform:uppercase}
.toolbar{display:flex;gap:12px;padding:14px 20px;flex-wrap:wrap}.search,.select{height:40px;background:#0e0c1a;color:#fff;border:1px solid var(--line);border-radius:5px;padding:0 12px;font:600 14px var(--body)}.search{flex:1;min-width:220px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px;padding:0 20px 20px}
.driver{display:grid;grid-template-columns:65px 1fr 75px;min-height:125px;background:linear-gradient(90deg,#15112a,#100d1f);border:1px solid #3a2a66;border-radius:7px;overflow:hidden}
.number{display:flex;align-items:center;justify-content:center;background:#2a1d55;font:700 28px var(--head)}.driver:nth-child(1) .number{background:#6f4a12}.driver:nth-child(2) .number{background:#3c3f90}.driver:nth-child(3) .number{background:#733817}
.driver-main{padding:14px;display:flex;flex-direction:column;justify-content:center;gap:4px}.driver-main h3{font:800 24px var(--head);text-transform:uppercase}.driver-main .team{color:var(--accent);font-weight:700;text-transform:uppercase}.driver-main .car{font-weight:600;color:#d4cde8}.avatar{width:52px;height:52px;border-radius:50%;overflow:hidden;margin:auto;background:#0d0b18;border:1px solid var(--line)}.avatar img{width:100%;height:100%;object-fit:cover}
.stats{display:grid;grid-template-columns:repeat(4,1fr);margin-top:16px}.stat{padding:20px;text-align:center;border-right:1px solid var(--line)}.stat:last-child{border:0}.stat b{display:block;font:700 36px var(--head);color:var(--accent)}.stat span{text-transform:uppercase;color:#d4cde8;font-weight:600}
.empty{padding:30px;text-align:center;color:var(--muted);font-weight:700;text-transform:uppercase;grid-column:1/-1}
.footer{display:grid;grid-template-columns:1fr auto 1fr;gap:15px;padding:16px 40px;border-top:1px solid var(--line);font-weight:700;text-transform:uppercase;letter-spacing:.08em}.footer-center{font-family:var(--brush);color:var(--accent);text-align:center}.footer-right{text-align:right}
@media(min-width:1550px){.page{max-width:1550px}}@media(max-width:1050px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:960px){.nav-toggle{display:block}.nav{display:none;left:0;right:0;top:58px;transform:none;flex-direction:column;background:rgba(8,7,14,.98)}.nav.open{display:flex}.nav a{padding:14px 24px}.grid{grid-template-columns:1fr}.stats{grid-template-columns:1fr 1fr}}@media(max-width:600px){.topbar{padding:0 16px}.hero-title{font-size:68px}.footer{grid-template-columns:1fr;text-align:center}.footer-right{text-align:center}}

/* PUBLIC LOGIN BUTTON */
.login-link{margin-left:auto;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-width:96px;height:36px;padding:0 14px;border:1px solid var(--accent);border-radius:3px;color:#fff;background:linear-gradient(180deg,#5c22c4 0%,var(--purple) 55%,#43149a 100%);box-shadow:0 0 12px rgba(168,85,255,.35),inset 0 1px 0 rgba(255,255,255,.1);font-family:var(--head);font-size:15px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;transition:filter .2s,box-shadow .2s}.login-link:hover{filter:brightness(1.12);box-shadow:0 0 18px rgba(178,102,255,.55),0 0 30px rgba(168,85,255,.22),inset 0 1px 0 rgba(255,255,255,.16)}.login-link svg{width:16px;height:16px;flex-shrink:0}
@media(max-width:960px){.login-link{min-width:82px;height:34px;padding:0 11px;font-size:13px;margin-left:10px}}

</style>
</head>
<body>
<header class="topbar">
<a href="/" class="brand">Jackal</a>
<button class="nav-toggle"><span></span><span></span><span></span></button>
<nav class="nav"><a href="/">Home</a><a href="/news">News</a><a href="/drivers" class="active">Drivers</a><a href="/rangliste">Rangliste</a><a href="/races">Races</a><a href="/blacklist">Blacklist</a><a href="/gallery">Gallery</a></nav><a class="login-link" href="/admin" aria-label="Zum Admin-Login"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V8a5 5 0 0 1 10 0v3"></path></svg><span>Login</span></a>
</header>

<section class="hero">
<img src="jackal-banner.png" alt="">
<div class="hero-content"><h1 class="hero-title">Drivers</h1><p class="hero-sub">Unsere Fahrer</p><p class="hero-claim">We are Jackal. We are racing.</p></div>
</section>

<main class="page">
<section class="card">
<div class="head"><h2>Drivers</h2><p>Unsere Fahrer der Jackal Racing League</p></div>
<div class="toolbar">
<input id="search" class="search" placeholder="Fahrer suchen...">
<select id="team" class="select"><option value="">Alle Teams</option></select>
<select id="car" class="select"><option value="">Alle Fahrzeuge</option></select>
</div>
<div id="grid" class="grid"></div>
</section>

<section class="card stats">
<div class="stat"><b id="sDrivers">0</b><span>Aktive Fahrer</span></div>
<div class="stat"><b id="sCars">0</b><span>Fahrzeugmodelle</span></div>
<div class="stat"><b id="sRaces">0</b><span>Rennen</span></div>
<div class="stat"><b id="sWins">0</b><span>Siege</span></div>
</section>
</main>

<footer class="footer"><span>Jackal Racing League</span><span class="footer-center">We are Jackal. We are racing.</span><span class="footer-right">Los Santos · Est. 2026</span></footer>

<script>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const media=v=>{if(!v)return'';v=String(v);if(v.startsWith('/media/'))return v;if(v.startsWith('media/'))return'/'+v;if(/^https?:/i.test(v))return v;return'/media/'+v.split('/').map(encodeURIComponent).join('/')};
(async()=>{
try{
const r=await fetch('/api/public/data',{cache:'no-store'}),d=await r.json();if(!d.ok)throw 0;
let drivers=(d.drivers||[]).filter(x=>String(x.status||'').toLowerCase()!=='inactive').sort((a,b)=>(Number(b.points)||0)-(Number(a.points)||0)||(Number(b.wins)||0)-(Number(a.wins)||0)||String(a.name||'').localeCompare(String(b.name||''),'de-DE'));
const teams=[...new Set(drivers.map(x=>x.team).filter(Boolean))].sort(),cars=[...new Set(drivers.map(x=>x.car).filter(Boolean))].sort();
teams.forEach(x=>team.add(new Option(x,x)));cars.forEach(x=>car.add(new Option(x,x)));
function render(){
let q=search.value.toLowerCase().trim(),t=team.value,c=car.value;
let list=drivers.filter(x=>(!q||[x.name,x.nickname,x.team,x.car].join(' ').toLowerCase().includes(q))&&(!t||x.team===t)&&(!c||x.car===c));
grid.innerHTML=list.length?list.map((x,i)=>`<article class="driver"><div class="number">#${String(x.number??i+1).padStart(2,'0')}</div><div class="driver-main"><h3>${esc(x.nickname||x.name||'Unbekannt')}</h3><div class="team">${esc(x.team||'Kein Team')}</div><div class="car">${esc(x.car||'Kein Fahrzeug')}</div><small>${Number(x.points)||0} Punkte · ${Number(x.wins)||0} Siege · ${Number(x.races)||0} Rennen</small></div><div class="avatar">${x.image_url||x.image?`<img src="${esc(media(x.image_url||x.image))}" alt="">`:''}</div></article>`).join(''):'<div class="empty">Kein Fahrer gefunden.</div>';
}
render();search.oninput=render;team.onchange=render;car.onchange=render;
sDrivers.textContent=drivers.length;sCars.textContent=cars.length;sRaces.textContent=(d.races||[]).length;sWins.textContent=drivers.reduce((s,x)=>s+(Number(x.wins)||0),0);
}catch(e){grid.innerHTML='<div class="empty">Fahrer konnten nicht geladen werden.</div>'}
})();
document.querySelector('.nav-toggle').onclick=()=>document.querySelector('.nav').classList.toggle('open');
</script>
</body>
</html>
