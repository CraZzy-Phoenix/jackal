<!DOCTYPE html>
<html lang="de">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Gallery – Jackal Racing League</title>
<link href="https://fonts.googleapis.com/css2?family=Permanent+Marker&family=Saira+Condensed:wght@600;700;800&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
<style>
:root{--bg:#07060d;--card:#110e1f;--card2:#171329;--line:#2a2342;--purple:#4e18ae;--accent:#b266ff;--neon:#a855ff;--text:#f2eefc;--muted:#a49cbc;--head:'Saira Condensed',sans-serif;--body:'Rajdhani',sans-serif;--brush:'Permanent Marker',cursive}
*{box-sizing:border-box;margin:0;padding:0}body{background:radial-gradient(1200px 500px at 50% 0,rgba(168,85,255,.12),transparent 60%),var(--bg);color:var(--text);font-family:var(--body);min-height:100vh}a{color:inherit;text-decoration:none}
.topbar{height:58px;position:sticky;top:0;z-index:50;display:flex;align-items:center;padding:0 36px;background:rgba(8,7,14,.94);border-bottom:1px solid var(--line)}.brand{font:30px var(--brush);text-transform:uppercase;text-shadow:0 0 12px rgba(178,102,255,.8),2px 2px 0 var(--purple)}.nav{position:absolute;left:50%;transform:translateX(-50%);display:flex}.nav a{padding:20px 15px;font-size:13px;font-weight:700;text-transform:uppercase;position:relative;color:#d9d3ec}.nav a:hover,.nav a.active{color:#fff}.nav a.active:after{content:"";position:absolute;left:10px;right:10px;bottom:5px;height:2px;background:var(--accent);box-shadow:0 0 10px var(--neon)}.nav-toggle{display:none;margin-left:auto;background:none;border:0}.nav-toggle span{display:block;width:24px;height:2px;background:#fff;margin:5px}
.hero{height:230px;position:relative;overflow:hidden;border-bottom:1px solid var(--line)}.hero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.hero:after{content:"";position:absolute;inset:0;background:linear-gradient(to bottom,rgba(7,6,13,.15),rgba(7,6,13,.75),var(--bg))}.hero-content{position:relative;z-index:2;height:100%;display:flex;flex-direction:column;justify-content:center;align-items:center}.hero-title{font:88px var(--brush);background:linear-gradient(#f1e8ff,#b98cff,#7a3fe0);background-clip:text;-webkit-background-clip:text;color:transparent;transform:skew(-10deg)}.hero-sub{margin-top:8px;font-weight:700;text-transform:uppercase;letter-spacing:.4em}.hero-claim{color:var(--accent);font-style:italic;font-weight:700}
.page{max-width:1500px;margin:18px auto;padding:0 18px 35px}.toolbar{display:flex;gap:12px;padding:16px;background:linear-gradient(100deg,rgba(168,85,255,.13),transparent 55%);border:1px solid var(--line);border-radius:10px;margin-bottom:16px;flex-wrap:wrap}.search,.select{height:40px;background:#0e0c1a;border:1px solid var(--line);color:#fff;border-radius:5px;padding:0 12px;font:600 14px var(--body)}.search{flex:1;min-width:220px}
.tabs{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:16px}.tab{border:1px solid var(--line);background:#100d1d;color:#d9d3ec;padding:8px 12px;border-radius:4px;cursor:pointer;font:700 13px var(--body);text-transform:uppercase}.tab.active{border-color:var(--accent);box-shadow:0 0 14px rgba(168,85,255,.35);color:#fff}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.tile{background:linear-gradient(180deg,var(--card2),var(--card));border:1px solid var(--line);border-radius:9px;overflow:hidden}.img{aspect-ratio:16/10;background:#0e0c1a}.img img{width:100%;height:100%;object-fit:cover}.caption{padding:12px 14px}.title{font:700 23px var(--head);text-transform:uppercase}.meta{margin-top:3px;color:var(--accent);font-size:13px;font-weight:700}.desc{margin-top:7px;color:var(--muted);font-size:14px}.empty{padding:30px;text-align:center;color:var(--muted);font-weight:700;grid-column:1/-1}
.lightbox{position:fixed;inset:0;background:rgba(0,0,0,.9);z-index:100;display:none;align-items:center;justify-content:center;padding:30px}.lightbox.open{display:flex}.lightbox img{max-width:min(1200px,90vw);max-height:85vh;object-fit:contain}.close{position:absolute;right:24px;top:18px;font-size:38px;color:#fff;cursor:pointer}
.footer{display:grid;grid-template-columns:1fr auto 1fr;gap:15px;padding:16px 40px;border-top:1px solid var(--line);font-weight:700;text-transform:uppercase;letter-spacing:.08em}.footer-center{font-family:var(--brush);color:var(--accent);text-align:center}.footer-right{text-align:right}
@media(min-width:1550px){.page{max-width:1550px}}@media(max-width:1050px){.grid{grid-template-columns:repeat(2,1fr)}}@media(max-width:960px){.nav-toggle{display:block}.nav{display:none;left:0;right:0;top:58px;transform:none;flex-direction:column;background:rgba(8,7,14,.98)}.nav.open{display:flex}.nav a{padding:14px 24px}.grid{grid-template-columns:1fr}}@media(max-width:600px){.topbar{padding:0 16px}.hero-title{font-size:68px}.footer{grid-template-columns:1fr;text-align:center}.footer-right{text-align:center}}

/* PUBLIC LOGIN BUTTON */
.login-link{margin-left:auto;display:inline-flex;align-items:center;justify-content:center;gap:7px;min-width:96px;height:36px;padding:0 14px;border:1px solid var(--accent);border-radius:3px;color:#fff;background:linear-gradient(180deg,#5c22c4 0%,var(--purple) 55%,#43149a 100%);box-shadow:0 0 12px rgba(168,85,255,.35),inset 0 1px 0 rgba(255,255,255,.1);font-family:var(--head);font-size:15px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;transition:filter .2s,box-shadow .2s}.login-link:hover{filter:brightness(1.12);box-shadow:0 0 18px rgba(178,102,255,.55),0 0 30px rgba(168,85,255,.22),inset 0 1px 0 rgba(255,255,255,.16)}.login-link svg{width:16px;height:16px;flex-shrink:0}
@media(max-width:960px){.login-link{min-width:82px;height:34px;padding:0 11px;font-size:13px;margin-left:10px}}

</style>

<style id="jackalPublicLoginStyle">
.jackal-login-overlay{position:fixed;inset:0;z-index:5000;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(4,3,10,.64);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px)}
.jackal-login-overlay.open{display:flex}
.jackal-login-modal{width:min(390px,calc(100vw - 32px));padding:26px;border:1px solid #2a2342;border-radius:10px;background:linear-gradient(180deg,#171329,#110e1f);box-shadow:0 24px 90px rgba(0,0,0,.65),0 0 28px rgba(168,85,255,.18);position:relative}
.jackal-login-close{position:absolute;top:12px;right:12px;width:32px;height:32px;border:1px solid #2a2342;border-radius:4px;background:#0f0c18;color:#cfc7dd;font:700 18px 'Rajdhani',sans-serif;line-height:1;cursor:pointer}.jackal-login-close:hover{color:#fff;border-color:#b266ff;box-shadow:0 0 12px rgba(168,85,255,.2)}
.jackal-login-kicker{font:700 12px 'Rajdhani',sans-serif;letter-spacing:.16em;text-transform:uppercase;color:#b266ff}.jackal-login-title{margin-top:4px;font:800 34px 'Saira Condensed',sans-serif;font-style:italic;text-transform:uppercase;color:#fff}.jackal-login-sub{margin-top:4px;color:#a49cbc;font:600 13px 'Rajdhani',sans-serif}
.jackal-login-form{margin-top:20px}.jackal-login-field{margin-bottom:12px}.jackal-login-field label{display:block;margin-bottom:6px;color:#b9b0ca;font:700 11px 'Rajdhani',sans-serif;letter-spacing:.1em;text-transform:uppercase}.jackal-login-field input{width:100%;height:42px;padding:0 12px;border:1px solid #2a2342;border-radius:5px;background:#0e0c1a;color:#fff;outline:none;font:600 14px 'Rajdhani',sans-serif}.jackal-login-field input:focus{border-color:#b266ff;box-shadow:0 0 0 2px rgba(168,85,255,.08)}
.jackal-login-submit{width:100%;height:42px;margin-top:4px;border:1px solid #b266ff;border-radius:4px;color:#fff;background:linear-gradient(180deg,#5c22c4 0%,#4e18ae 55%,#43149a 100%);box-shadow:0 0 16px rgba(168,85,255,.3),inset 0 1px 0 rgba(255,255,255,.08);font:800 16px 'Saira Condensed',sans-serif;letter-spacing:.05em;text-transform:uppercase;cursor:pointer}.jackal-login-submit:hover{filter:brightness(1.1);box-shadow:0 0 22px rgba(178,102,255,.48)}
.jackal-login-message{min-height:18px;margin-top:10px;color:#ff6f8d;font:600 12px 'Rajdhani',sans-serif;text-align:center}.jackal-login-note{margin-top:12px;color:#716981;font:500 11px 'Rajdhani',sans-serif;text-align:center}
.login-link.is-authenticated{border-color:#6f3ad7}
@media(max-width:960px){.jackal-login-modal{padding:22px}.jackal-login-title{font-size:30px}}
</style>


<style id="jackalResponsiveLayout">
/* JACKAL RESPONSIVE CANVAS
   One visual system for 1080p / 1440p / 2160p desktop sizes.
   Content grows with the viewport instead of staying trapped in a small fixed column. */
html,body{overflow-x:hidden}
.nav a{font-size:clamp(12px,.7vw,15px);padding-left:clamp(10px,.75vw,16px);padding-right:clamp(10px,.75vw,16px)}
@media (min-width:961px){
  .page{width:min(calc(100% - 48px),1800px);max-width:1800px;margin-left:auto;margin-right:auto}
  .grid{width:min(calc(100% - 48px),1800px);max-width:1800px}
  .hero-title{font-size:clamp(72px,5.25vw,112px)}
  .footer{font-size:clamp(12px,.70vw,16px)}
}
@media (min-width:1440px){
  .topbar{padding-left:40px;padding-right:40px}
  .page{padding-left:22px;padding-right:22px}
  .grid{gap:20px}
  .grid .card{border-radius:12px}
}
@media (min-width:1800px){
  .head{padding:22px 24px}
  .head h2{font-size:clamp(30px,1.45vw,38px)}
  .toolbar{padding-left:24px;padding-right:24px}
  .grid{gap:20px;padding-left:22px;padding-right:22px}
  .name,.race-title,.title{font-size:clamp(24px,1.35vw,32px)}
}
@media (min-width:2400px){
  .topbar{padding-left:54px;padding-right:54px}
  .page{width:min(calc(100% - 80px),2000px);max-width:2000px}
  .grid{width:min(calc(100% - 80px),2000px);max-width:2000px}
}
</style>

<script id="jackal-site-config-loader">
(function(){
  if(window.__JACKAL_SITE_CONFIG_LOADER_INSTALLED)return;
  window.__JACKAL_SITE_CONFIG_LOADER_INSTALLED=true;

  const pagePath=location.pathname.toLowerCase();
  const clamp=(n,min,max)=>Math.max(min,Math.min(max,n));
  const pxValue=(v,fallback)=>{
    const s=String(v??'').trim();
    return /^-?\d+(?:\.\d+)?px$/.test(s)?s:fallback;
  };

  function chooseResponsive(rows){
    const width=window.innerWidth;
    return (Array.isArray(rows)?rows:[]).find(x=>{
      const min=Number(x.min_viewport_width||0);
      const max=x.max_viewport_width==null||x.max_viewport_width===''?Infinity:Number(x.max_viewport_width);
      return width>=min && width<=max;
    })||null;
  }

  function setRootVar(name,value){
    if(value!==undefined&&value!==null&&String(value)!=='')document.documentElement.style.setProperty(name,String(value));
  }

  function normalizeUrl(url){
    const s=String(url||'').trim();
    if(!s)return '';
    return s.startsWith('http')||s.startsWith('/')||s.startsWith('data:')?s:'/'+s;
  }

  function applyDesign(config){
    const d=config?.design||{};
    const r=chooseResponsive(config?.responsive||[]);
    const vars={
      '--bg':d.bg_color,
      '--bg-2':d.bg2_color,
      '--bg2':d.bg2_color,
      '--card':d.card_color,
      '--card-2':d.card2_color,
      '--card2':d.card2_color,
      '--line':d.line_color,
      '--line-glow':d.line_glow_color,
      '--purple':d.purple_color,
      '--purple-2':d.purple2_color,
      '--accent':d.purple2_color,
      '--purple-3':d.purple3_color,
      '--neon':d.neon_color,
      '--text':d.text_color,
      '--muted':d.muted_color,
      '--brush':d.brush_font_family,
      '--f-brush':d.brush_font_family,
      '--head':d.head_font_family,
      '--f-head':d.head_font_family,
      '--body':d.body_font_family,
      '--f-body':d.body_font_family,
      '--radius':pxValue(d.radius_px,'10px'),
      '--site-radius':pxValue(d.radius_px,'10px'),
      '--site-brush-size':pxValue(d.brush_font_size,'30px'),
      '--site-head-size':pxValue(d.head_font_size,'23px'),
      '--site-body-size':pxValue(d.body_font_size,'16px'),
      '--site-brush-weight':d.brush_font_weight||400,
      '--site-head-weight':d.head_font_weight||700,
      '--site-body-weight':d.body_font_weight||600,
      '--site-brush-style':d.brush_font_style||'normal',
      '--site-head-style':d.head_font_style||'normal',
      '--site-body-style':d.body_font_style||'normal',
      '--site-brush-color':d.brush_font_color,
      '--site-head-color':d.head_font_color,
      '--site-body-color':d.body_font_color,
      '--site-small-color':d.small_text_color,
      '--site-glow-strength':String(clamp(Number(d.glow_strength??100),0,200))/100,
      '--site-shadow-strength':String(clamp(Number(d.shadow_strength??100),0,200))/100,
      '--site-overlay-strength':String(clamp(Number(d.overlay_strength??100),0,100))/100,
      '--site-blur':pxValue(d.backdrop_blur_px,'8px'),
      '--site-page-max':pxValue(d.page_max_width,'1500px'),
      '--site-page-gutter':pxValue(d.page_gutter,'18px'),
      '--site-gap':pxValue(d.section_gap_px,'14px'),
      '--site-topbar-height':pxValue(d.topbar_height_px,'58px'),
      '--site-hero-height':pxValue(d.hero_height_px,'320px'),
      '--site-content-width':r?.content_width||'92vw',
      '--site-responsive-max':r?.max_content_width||pxValue(d.page_max_width,'1500px'),
      '--site-responsive-gutter':r?.page_gutter||pxValue(d.page_gutter,'18px'),
      '--site-scale':r?.scale||1,
      '--site-responsive-hero':pxValue(r?.hero_height_px,pxValue(d.hero_height_px,'320px')),
      '--site-responsive-topbar':pxValue(r?.topbar_height_px,pxValue(d.topbar_height_px,'58px')),
      '--site-responsive-gap':pxValue(r?.section_gap_px,pxValue(d.section_gap_px,'14px'))
    };
    Object.entries(vars).forEach(([k,v])=>setRootVar(k,v));
    const root=document.documentElement;
    root.dataset.siteAnimations=Number(d.animations_enabled??1)===1?'1':'0';
    root.dataset.siteHover=Number(d.hover_effects??1)===1?'1':'0';
    root.dataset.siteGradient=Number(d.background_gradient_enabled??1)===1?'1':'0';
  }

  function applyBrandLogo(config){
    const media=Array.isArray(config?.media)?config.media:[];
    const item=media.find(x=>String(x.slot)==='logo_small'&&Number(x.active??1)!==0);
    const url=normalizeUrl(item?.image_url);
    if(!url)return;
    const brands=document.querySelectorAll('.brand');
    brands.forEach(brand=>{
      let img=brand.querySelector('.site-brand-img');
      if(!img){
        img=document.createElement('img');
        img.className='site-brand-img';
        img.alt=item?.alt_text||'JACKAL';
        brand.appendChild(img);
      }
      img.src=url;
      img.alt=item?.alt_text||'JACKAL';
      brand.classList.add('site-brand-logo-active');
    });
  }

  function applyMedia(config){
    const active=(Array.isArray(config?.media)?config.media:[]).filter(x=>Number(x.active??1)!==0);
    const bySlot=new Map(active.map(x=>[String(x.slot),x]));
    const src=(slot)=>normalizeUrl(bySlot.get(slot)?.image_url||'');
    const set=(selector,slot)=>{
      const url=src(slot);if(!url)return;
      document.querySelectorAll(selector).forEach(img=>{
        if(img.getAttribute('src')!==url)img.src=url;
        const alt=bySlot.get(slot)?.alt_text;if(alt)img.alt=alt;
      });
    };

    set('img[src*="jackal-banner.png"]','main_banner');
    set('.hero-bg img','main_banner');
    set('.brand-slot img','logo_small');
    set('.hero-logo-slot img','logo');

    if(pagePath.endsWith('/')||pagePath.endsWith('/index.html')||pagePath.includes('/index')){
      set('.next-race-bg img','home_next_race');
      set('.champion-bg img','home_champion_bg');
      set('.champion-avatar img','home_champion_driver');
      set('.car-thumb img','home_champion_car');
    }
    if(pagePath.endsWith('/news')||pagePath.includes('/news')){
      set('.race-card .race-bg img','news_race_background');
      set('.winner-img img','news_hearts');
    }

    set('img[src*="team-jackal.png"]','team_jackal');
    set('img[src*="team-nightshift.png"]','team_nightshift');
    set('img[src*="team-phantom.png"]','team_phantom');
    set('img[src*="team-velocity.png"]','team_velocity');

    applyBrandLogo(config);
    if(window.wireImageSlots)try{window.wireImageSlots();}catch{}
  }

  function applyTexts(config){
    const rows=Array.isArray(config?.texts)?config.texts.filter(x=>Number(x.active??1)!==0):[];
    const byKey=new Map(rows.map(x=>[String(x.text_key),x.value]));
    const text=(key)=>byKey.get(key);
    const set=(selector,key)=>{
      const value=text(key);if(value===undefined)return;
      document.querySelectorAll(selector).forEach(el=>el.textContent=String(value));
    };

    const websiteName=text('global.website_name');
    if(websiteName){
      document.title=pagePath.endsWith('/news')||pagePath.includes('/news')?
        `${websiteName} – News`:
        document.title.replace(/Jackal Racing League|JACKAL RACING LEAGUE/gi,websiteName);
    }
    set('.footer > span:first-child','global.footer_left');
    set('.footer .footer-claim,.footer .footer-center','global.footer_claim');
    set('.footer > span:last-child,.footer .footer-right','global.footer_right');
    set('.hero-claim','global.website_slogan');

    if(pagePath.endsWith('/news')||pagePath.includes('/news')){
      set('.news-title','news.page_title');
      set('.hero-sub','news.page_subtitle');
    }
    if(pagePath.endsWith('/')||pagePath.endsWith('/index.html')||pagePath.includes('/index')){
      set('.next-race h2.brush','home.next_race_title');
      set('.news .card-head .head-title','home.latest_news_title');
      set('.champion .card-head .head-title','home.champion_title');
    }
  }

  function installResponsiveStyle(){
    if(document.getElementById('jackal-site-config-style'))return;
    const s=document.createElement('style');
    s.id='jackal-site-config-style';
    s.textContent=`
      :root{--site-scale:1;--site-content-width:92vw;--site-responsive-max:1500px;--site-responsive-gutter:18px;--site-responsive-hero:320px;--site-responsive-topbar:58px;--site-responsive-gap:14px}
      html,body{font-family:var(--f-body)!important;font-size:var(--site-body-size,16px)!important;font-weight:var(--site-body-weight,600)!important;font-style:var(--site-body-style,normal)!important;color:var(--site-body-color,var(--text))}
      body{background-color:var(--bg)!important;}
      body[data-site-scaling="1"]{zoom:var(--site-scale,1)}
      .topbar{height:var(--site-responsive-topbar)!important;backdrop-filter:blur(var(--site-blur,8px))}
      .hero{height:var(--site-responsive-hero)!important}
      .page,.grid,.grid-news{width:var(--site-content-width)!important;max-width:var(--site-responsive-max)!important;margin-left:auto!important;margin-right:auto!important}
      .grid,.grid-news{gap:var(--site-responsive-gap)!important}
      .page,.grid,.grid-news{padding-left:var(--site-responsive-gutter)!important;padding-right:var(--site-responsive-gutter)!important}
      .card,.race,.item,.tile{border-radius:var(--site-radius,var(--radius,10px))!important}
      .brand,.brand-text,.brush,.footer-claim{font-family:var(--f-brush)!important;font-weight:var(--site-brush-weight,400)!important;font-style:var(--site-brush-style,normal)!important;color:var(--site-brush-color,var(--text))!important}
      .brand{font-size:var(--site-brush-size,30px)!important}
      .brush,.footer-claim{font-size:var(--site-brush-size,30px)!important}
      .hero-title,.news-title,.page-title{font-family:var(--f-brush)!important;font-weight:var(--site-brush-weight,400)!important;font-style:var(--site-brush-style,normal)!important;color:var(--site-brush-color,var(--text))!important}
      .hero-title{font-size:clamp(calc(var(--site-brush-size,30px) * 2),8vw,calc(var(--site-brush-size,30px) * 4.5))!important}
      .news-title,.page-title{font-size:clamp(calc(var(--site-brush-size,30px) * 1.5),6vw,calc(var(--site-brush-size,30px) * 2.8))!important}
      .head-title,.big-title{font-family:var(--f-head)!important;font-size:var(--site-head-size,23px)!important;font-weight:var(--site-head-weight,700)!important;font-style:var(--site-head-style,normal)!important;color:var(--site-head-color,var(--text))!important}
      .hero-content .hero-sub,.hero-sub,.head-sub,.big-sub,.small,.footer{font-family:var(--f-body)!important}
      .head-sub,.big-sub{color:var(--site-small-color,var(--muted))!important}
      .hero-claim{color:var(--site-small-color,var(--muted))!important}
      .footer{color:var(--site-body-color,var(--text))!important}
      .card,.stat,.tile,.item,.race{box-shadow:0 10px 30px rgba(0,0,0,calc(.45 * var(--site-shadow-strength,1)))!important}
      .hero-overlay{opacity:var(--site-overlay-strength,1)!important}
      .hero-title,.news-title,.page-title,.brush-purple,.btn,.head-icon,.big-icon,.cd-box span{filter:drop-shadow(0 0 calc(8px * var(--site-glow-strength,1)) var(--neon))}
      html[data-site-animations="0"] *,html[data-site-animations="0"] *::before,html[data-site-animations="0"] *::after{animation:none!important;transition:none!important}
      html[data-site-hover="0"] .driver-card:hover,html[data-site-hover="0"] .bl-card:hover,html[data-site-hover="0"] .race-tile:hover,html[data-site-hover="0"] .g-tile:hover,html[data-site-hover="0"] .news-item:hover{transform:none!important;box-shadow:none!important;filter:none!important}
      html[data-site-gradient="0"] body{background-image:none!important}
      .site-brand-img{display:none;width:110px;height:40px;object-fit:contain}
      .brand.site-brand-logo-active{display:flex;align-items:center;justify-content:center}
      .brand.site-brand-logo-active>.site-brand-img{display:block}
      .brand.site-brand-logo-active{font-size:0!important}
      @media(max-width:960px){.topbar{height:var(--site-responsive-topbar)!important}.hero{height:var(--site-responsive-hero)!important}.page,.grid,.grid-news{width:calc(100% - 2 * var(--site-responsive-gutter))!important;max-width:none!important}}
    `;
    document.head.appendChild(s);
  }

  function apply(config){
    installResponsiveStyle();
    applyDesign(config);
    applyMedia(config);
    applyTexts(config);
    document.body?.setAttribute('data-site-scaling','1');
  }

  window.__JACKAL_SITE_CONFIG_PROMISE=fetch('/api/public/site-config',{cache:'no-store',credentials:'same-origin'})
    .then(r=>{if(!r.ok)throw new Error('Site-Config konnte nicht geladen werden.');return r.json();})
    .then(config=>{window.__JACKAL_SITE_CONFIG=config;apply(config);return config;})
    .catch(err=>{console.warn('[JACKAL] Site-Config:',err);return null;});

  window.__JACKAL_APPLY_SITE_CONFIG=function(){if(window.__JACKAL_SITE_CONFIG)apply(window.__JACKAL_SITE_CONFIG);};
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',()=>{installResponsiveStyle();if(window.__JACKAL_SITE_CONFIG)apply(window.__JACKAL_SITE_CONFIG);});
  else{installResponsiveStyle();if(window.__JACKAL_SITE_CONFIG)apply(window.__JACKAL_SITE_CONFIG);}
})();
</script>

</head>
<body>
<header class="topbar"><a href="/" class="brand">Jackal</a><button class="nav-toggle"><span></span><span></span><span></span></button><nav class="nav"><a href="/">Home</a><a href="/news">News</a><a href="/drivers">Drivers</a><a href="/rangliste">Rangliste</a><a href="/races">Races</a><a href="/blacklist">Blacklist</a><a href="/gallery" class="active">Gallery</a></nav><a class="login-link" href="/admin" aria-label="Zum Admin-Login"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="11" width="18" height="10" rx="2"></rect><path d="M7 11V8a5 5 0 0 1 10 0v3"></path></svg><span>Login</span></a></header>

<section class="hero"><img src="jackal-banner.png" alt=""><div class="hero-content"><h1 class="hero-title">Gallery</h1><p class="hero-sub">Bilder & Highlights</p><p class="hero-claim">We are Jackal. We are racing.</p></div></section>

<main class="page">
<div class="toolbar"><input id="search" class="search" placeholder="Fotos durchsuchen..."><select id="sort" class="select"><option value="new">Neueste zuerst</option><option value="old">Älteste zuerst</option><option value="likes">Beliebteste</option></select></div>
<div id="tabs" class="tabs"></div>
<section id="grid" class="grid"></section>
</main>

<div id="lightbox" class="lightbox"><div id="lightboxClose" class="close">×</div><img id="lightboxImg" src="" alt=""></div>

<footer class="footer"><span>Jackal Racing League</span><span class="footer-center">We are Jackal. We are racing.</span><span class="footer-right">Los Santos · Est. 2026</span></footer>

<script>
const esc=v=>String(v??'').replace(/[&<>'"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;',"'":'&#39;','"':'&quot;'}[c]));
const media=v=>{if(!v)return'';v=String(v);if(v.startsWith('/media/'))return v;if(v.startsWith('media/'))return'/'+v;if(/^https?:/i.test(v))return v;return'/media/'+v.split('/').map(encodeURIComponent).join('/')};
const date=v=>{if(!v)return'—';let d=new Date(v);return isNaN(d)?String(v):new Intl.DateTimeFormat('de-DE',{day:'2-digit',month:'2-digit',year:'numeric'}).format(d)};
const gridEl=document.getElementById('grid'),searchEl=document.getElementById('search'),sortEl=document.getElementById('sort'),tabsEl=document.getElementById('tabs'),lightboxEl=document.getElementById('lightbox'),lightboxImgEl=document.getElementById('lightboxImg'),closeEl=document.getElementById('lightboxClose');
(async()=>{
try{
 const r=await fetch('/api/public/data',{cache:'no-store'}),d=await r.json();if(!r.ok||!d.ok)throw new Error(d.error||'Website-Daten konnten nicht geladen werden.');
 const items=(d.gallery||[]).filter(x=>String(x.status||'').toLowerCase()!=='inactive');
 const categories=[...new Set(items.map(x=>x.category).filter(Boolean))].sort((a,b)=>String(a).localeCompare(String(b),'de-DE'));
 tabsEl.innerHTML='<button class="tab active" data-cat="">Alle</button>'+categories.map(x=>`<button class="tab" data-cat="${esc(x)}">${esc(x)}</button>`).join('');
 let current='';
 function render(){const q=searchEl.value.toLowerCase().trim(),s=sortEl.value;let list=items.filter(x=>(!q||[x.title,x.description,x.category,x.event,x.car,x.driver].join(' ').toLowerCase().includes(q))&&(!current||String(x.category||'').split('|').includes(current)));list.sort((a,b)=>{if(s==='likes')return (Number(b.likes)||0)-(Number(a.likes)||0);if(s==='old')return new Date(a.date||a.created_at)-new Date(b.date||b.created_at);return new Date(b.date||b.created_at)-new Date(a.date||a.created_at);});gridEl.innerHTML=list.length?list.map(x=>`<figure class="tile" data-gallery-id="${esc(String(x.id||''))}" data-src="${esc(media(x.image_url||x.image))}"><div class="img">${x.image_url||x.image?`<img src="${esc(media(x.image_url||x.image))}" alt="">`:''}</div><figcaption class="caption"><div class="title">${esc(x.title||'Gallery')}</div><div class="meta">${esc(date(x.date||x.created_at))} · ${esc(x.category||x.event||'Gallery')}</div>${x.description?`<p class="desc">${esc(x.description)}</p>`:''}</figcaption></figure>`).join(''):'<div class="empty">Keine Fotos gefunden.</div>';}
 render();searchEl.oninput=render;sortEl.onchange=render;
 tabsEl.onclick=e=>{const b=e.target.closest('.tab');if(!b)return;tabsEl.querySelectorAll('.tab').forEach(x=>x.classList.remove('active'));b.classList.add('active');current=b.dataset.cat||'';render();};
 gridEl.onclick=e=>{const t=e.target.closest('.tile');if(!t||!t.dataset.src)return;lightboxImgEl.src=t.dataset.src;lightboxEl.classList.add('open');};
 closeEl?.addEventListener('click',()=>lightboxEl.classList.remove('open'));lightboxEl?.addEventListener('click',e=>{if(e.target===lightboxEl)lightboxEl.classList.remove('open')});
}catch(e){console.error(e);gridEl.innerHTML='<div class="empty">Gallery konnte nicht geladen werden.</div>';}
})();
document.querySelector('.nav-toggle')?.addEventListener('click',()=>document.querySelector('.nav')?.classList.toggle('open'));
</script>

